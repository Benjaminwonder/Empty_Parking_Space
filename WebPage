    h("span", "badge", "Route started", badges);

    add("div", totalMeters(pts) + " m from the lot entrance", "total");

    const ol = add("ol", undefined, "steps");
    stepsFor(st).forEach(function (text) {
        h("li", undefined, text, ol);
    });

    if (myClaim !== null && myClaim.stall_id === route.id) {
        const box = add("div", undefined, "claim-box");
        if (myClaim.phase === "arrived" || myClaim.phase === "car_seen") {   // car_seen: slice BD-18 asks whose
            h("b", undefined, "Car detected in your spot", box);
            h("div", undefined, "It stays yours until the sensor sees it empty again.", box);
        } else {
            h("b", undefined, "Held for you until " + campusClock(myClaim.deadline), box);
            h("div", undefined, "If no car reaches it by then, it goes back to other drivers.", box);
        }
        const rel = h("button", "btn", "Release spot", box);
        rel.addEventListener("click", releaseSpot);
    }

    const age = stallInfo[route.id] ? formatAge(stallInfo[route.id].age_s) : "";
    const mineNow = myClaim !== null && myClaim.stall_id === route.id;
    // "reserved" is our own hold laid over the sensor; say what the camera itself last saw
    const seenState = mineNow && stallInfo[route.id] ? stallInfo[route.id].last_claim : statusOf(route.id);
    add("div", "Live status: " + String(seenState).replace("_", " ") + (age ? " (" + age + ")" : "") +
               ". This shows the way to the spot, it doesn't promise the spot is free.", "status-note");

    const show = add("button", "Show lot", "btn");
    show.addEventListener("click", openForRoute);

    const end = add("button", "End route", "btn");
    end.addEventListener("click", endRoute);
}

