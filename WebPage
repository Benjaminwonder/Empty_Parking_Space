    const ageEl = document.getElementById("closeupAge");
    const closeSvg = document.getElementById("closeupSvg");

    while (closeSvg.firstChild) {
        closeSvg.removeChild(closeSvg.firstChild);
    }

    if (route === null) {
        box.classList.remove("show");
        return;
    }
    box.classList.add("show");
    titleEl.textContent = "You are here \u00b7 Main Gate";

    // DK-3: the picked stall's own age, so the close-up says how fresh the
    // claim is, not just where the gate is
    const routeAge = stallInfo[route.id] ? formatAge(stallInfo[route.id].age_s) : "";
    ageEl.textContent = routeAge ? "Your spot's last update: " + routeAge : "";

    const HALF = 130;
    const x0 = GATE_X - HALF;
    const x1 = GATE_X + HALF;
    const y0 = GATE_Y - HALF * 0.8;
    const y1 = GATE_Y + HALF * 0.8;

    closeSvg.setAttribute("viewBox", x0 + " " + y0 + " " + (x1 - x0) + " " + (y1 - y0));

    el("rect", { x: x0, y: y0, width: x1 - x0, height: y1 - y0, fill: "#cfe3c1" }, closeSvg);

    // the two roads that cross at the gate (Woodland Blvd and Michigan Ave)
    el("rect", { x: x0, y: GATE_Y - ROAD_HALF, width: x1 - x0, height: ROAD_HALF * 2,
                 fill: "#9aa0a6" }, closeSvg);
    el("rect", { x: GATE_X - ROAD_HALF, y: y0, width: ROAD_HALF * 2, height: y1 - y0,
                 fill: "#9aa0a6" }, closeSvg);

    // any nearby buildings, close enough to show up in this tight a crop
    BUILDINGS.forEach(function (b) {
        b.parts.forEach(function (p) {
            const bx = p[0] * S, by = p[1] * S, bw = p[2] * S, bh = p[3] * S;
            if (bx + bw < x0 || bx > x1 || by + bh < y0 || by > y1) {
                return;
            }
            el("rect", { x: bx, y: by, width: bw, height: bh, rx: 3, fill: "#ddd2c2",
                         stroke: "#a99a86", "stroke-width": 1.5 }, closeSvg);
        });
    });

    // the gate marker itself
    el("circle", { cx: GATE_X, cy: GATE_Y, r: 10, fill: "#ffffff", stroke: "#14532d",
                   "stroke-width": 4 }, closeSvg);

    // the start of the route, leaving the gate
    const st = stalls[route.id];
    const m = markerFor(st.zone);
    // the first leg of the drive, so the inset points the way the route actually leaves the gate
    const ap = approachPath(st.zone);
    const east = ap === null || ap[1][0] >= GATE_X;
    const firstLeg = [east ? Math.min(x1, GATE_X + HALF) : Math.max(x0, GATE_X - HALF), GATE_Y];
    const d = roundedPath([[GATE_X, GATE_Y], firstLeg], 10);
    el("path", { d: d, fill: "none", stroke: "#ffffff", "stroke-width": 8,
                 "stroke-linecap": "round" }, closeSvg);
    el("path", { d: d, fill: "none", stroke: "#1a73e8", "stroke-width": 4,
                 "stroke-linecap": "round",
                 "class": route.started ? "" : "route-flow" }, closeSvg);

    el("text", { x: x0 + 8, y: y0 + 16, "font-size": 11, "font-weight": "bold",
                 fill: "#14532d" }, closeSvg, "Heading " + (east ? "east" : "west") + " to " +
                 (m ? lotName(st.zone) : "the lot"));
}

function selectSpot(id) {
    route = { id: id, started: false, auto: false };
    drawMapRoute();
    refreshSelection();
    showHelp();
}

function startRoute() {
    if (route === null) {
        return;
    }
    route.started = true;
    drawMapRoute();
    closeWindow();
    showRoute();
}

function endRoute() {
    route = null;
    drawMapRoute();
    markBuilding(null);
    selectedBuilding = null;
    if (winOpen) {
        refreshSelection();
    }
    showHelp();
}

const winBack = document.getElementById("winBack");
const winTitle = document.getElementById("winTitle");
const winSub = document.getElementById("winSub");
const winBody = document.getElementById("winBody");
const winFoot = document.getElementById("winFoot");

function h(tag, cls, text, parent) {
    const e = document.createElement(tag);
    if (cls) {
        e.className = cls;
    }
    if (text !== undefined) {
        e.textContent = text;
    }
    if (parent) {
        parent.appendChild(e);
    }
    return e;
}

// why: "closest lots to this building", measured on the campus picture between the building and each lot pin.
// boundary: picture distance only; z.x/z.y are the pop-up's drawing space (every lot shares one
//           origin there), so measuring with them would call the same two lots closest to everything.
// ugly: lots hidden by the tab (no ADA/EV stall) are skipped; no metres are quoted until real coordinates.
function closestLots(cx, cy) {
    const list = [];
    zones.forEach(function (z) {
        const m = markerFor(z);
        if (m && tabIds(z).length > 0) {
            list.push({ z: z, d: dist([cx, cy], [(m.x + m.w / 2) * S, (m.y + m.h / 2) * S]) });
        }
    });
    list.sort(function (a, b) {
        return a.d - b.d;
    });
    return list.slice(0, 2).map(function (item, i) {
        return { z: item.z, rank: i };
    });
}

function openForBuilding(entry) {
