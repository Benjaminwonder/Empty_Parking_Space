// where a lot's label sits around its pin; "below" goes under the paved area, clear of the pin
function setPillSide(p, side) {
    p.side = side;
    const t = { right: [20, -52], left: [-p.pillW - 20, -52], below: [-p.pillW / 2, p.markerH + 14],
                above: [-p.pillW / 2, -88] }[side];
    p.pill.setAttribute("transform", "translate(" + t[0] + " " + t[1] + ")");
}

// where a landmark's name sits around its pin
function setNameSide(label, side) {
    const px = +label.getAttribute("data-px"), py = +label.getAttribute("data-py");
    const t = { right: [px + 20, py - 22, "start"], left: [px - 20, py - 22, "end"],
                above: [px, py - 50, "middle"], below: [px, py + 18, "middle"] }[side];
    label.setAttribute("x", t[0]);
    label.setAttribute("y", t[1]);
    label.setAttribute("text-anchor", t[2]);
    label.dataset.side = side;
}

function overlapArea(a, b) {
    const w = Math.min(a.right, b.right) - Math.max(a.left, b.left);
    const h = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);
    return w > 0 && h > 0 ? w * h : 0;
}

// why: names are the point of the map, so no label may sit on another name, a pin or another lot's label;
//      each label tries right, left, below and above its pin and keeps the spot that covers least.
// boundary: moves lot labels and landmark names only; pins, lots and buildings never move.
// ugly: a label is only moved when it actually covers something, so counts ticking up and down
//       don't make labels hop sides every few seconds; off-screen spots count as covering.
function placeLabels() {
    const vis = function (e) { return getComputedStyle(e).display !== "none"; };
    const view = scroller.getBoundingClientRect();
    const names = buildingNodes.filter(function (e) { return e.landmark; }).map(function (e) { return e.label; });
    const pins = buildingNodes.filter(function (e) { return vis(e.pin); })
        .map(function (e) { return e.pin.querySelector("path"); });
    const lots = Object.keys(lotPins).map(function (k) { return lotPins[k]; })
        .filter(function (p) { return vis(p.pin); });
    const cost = function (box, self, others) {
        let c = 0;
        others.forEach(function (o) {
            if (o !== self) {
                c += overlapArea(box, o.getBoundingClientRect());
            }
        });
        const outside = (box.right - box.left) * (box.bottom - box.top) -
                        overlapArea(box, view);
        return c + 4 * outside;
    };
    const choose = function (current, sides, apply, measure, self, others) {
        apply(current);
        if (cost(measure(), self, others) === 0) {
            return;
        }
        let best = current, bestCost = Infinity;
        sides.forEach(function (side) {
            apply(side);
            const c = cost(measure(), self, others);
            if (c < bestCost - 1) {
                best = side;
                bestCost = c;
            }
        });
        apply(best);
    };
    // landmark names first (they avoid pins and each other), then lot labels (they avoid everything)
    names.forEach(function (label) {
        const others = pins.concat(names).concat(lots.map(function (p) { return p.body; }));
        choose(label.dataset.side || "right", ["right", "left", "above", "below"],
               function (side) { setNameSide(label, side); },
               function () { return label.getBoundingClientRect(); }, label, others);
    });
    lots.forEach(function (p) {
        const others = pins.concat(names)
            .concat(lots.map(function (q) { return q.body; }))
            .concat(lots.filter(function (q) { return q !== p; }).map(function (q) { return q.box; }));
        choose(p.side, ["right", "left", "below", "above"],
               function (side) { setPillSide(p, side); },
               function () { return p.box.getBoundingClientRect(); }, p.box, others);
    });
}

function updateLotPins() {
    renderLotList();
    zones.forEach(function (z) {
        const p = lotPins[z.id];
