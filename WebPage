const scroller = document.getElementById("scroll");
let zoom = 1;

let fitZoom = null;   // the zoom Fit chose; zooming past it hides the legend (it would cover what you zoomed into)
let viewPad = 0;      // how far the drawing runs on past the picture on each side, in map pixels

function applyZoom() {
    svg.setAttribute("width", Math.round((MAP_W + 2 * viewPad) * zoom));
    svg.setAttribute("height", Math.round(MAP_H * zoom));
    document.querySelector(".map-box").classList.toggle("zoomed", fitZoom !== null && zoom > fitZoom + 0.01);
}

const bleedLayer = el("g", {}, treeLayer);

// why: a wide screen and a near-square campus leave spare width; rather than empty lawn, the streets,
//      lawn and trees carry on past the picture's edges, so the map fills its box like a real map.
// boundary: widens the viewBox and extends background, full-length roads and trees; buildings,
//           lots and pins are untouched.
// ugly: the extra trees are decoration only; nothing clickable lives in the margins.
function bleed(pad) {
    viewPad = pad;
    svg.setAttribute("viewBox", (-pad) + " 0 " + (MAP_W + 2 * pad) + " " + MAP_H);
    bgLawn.setAttribute("x", -pad);
    bgLawn.setAttribute("width", MAP_W + 2 * pad);
    gateLine.setAttribute("x1", -pad);
    gateLine.setAttribute("x2", MAP_W + pad);
    const bands = [];
    roadLayer.querySelectorAll(".full-road").forEach(function (r) {
        r.setAttribute("x", -pad);
        r.setAttribute("width", MAP_W + 2 * pad);
        bands.push([+r.getAttribute("y") - 14, +r.getAttribute("y") + +r.getAttribute("height") + 14]);
    });
    while (bleedLayer.firstChild) {
        bleedLayer.removeChild(bleedLayer.firstChild);
    }
    if (pad < 10) {
        return;
    }
    // a fixed-seed random scatter: looks natural, and the same trees come back on every Fit
    let seed = 20261012;
    const rand = function () {
        seed = (seed * 1664525 + 1013904223) % 4294967296;
        return seed / 4294967296;
    };
    const count = Math.round(2 * pad * MAP_H / 1900);   // about the campus's own tree density
    for (let i = 0; i < count; i++) {
        const left = rand() < 0.5;
        const x = left ? -pad + 8 + rand() * (pad - 16) : MAP_W + 8 + rand() * (pad - 16);
        const y = rand() * MAP_H;
        if (bands.some(function (b) { return y > b[0] && y < b[1]; })) {
            continue;
        }
        const r = 8 + (i % 4) * 2;
        el("circle", { cx: x + 2, cy: y + 3, r: r, fill: "#000000", opacity: 0.1 }, bleedLayer);
        el("circle", { cx: x, cy: y, r: r, fill: (i % 3 === 0 ? "#7fae6e" : "#8fbb7d") }, bleedLayer);
    }
}

// why: the whole campus in view, no scrolling, in whatever box the layout leaves the map.
// boundary: sets zoom and the drawing's margins; draws nothing else.
// ugly: on narrow screens (phones) the column sits under the map, so the map fits the width instead.
function fit() {
    const bw = scroller.clientWidth, bh = scroller.clientHeight;
    if (window.innerWidth <= 900) {
        zoom = Math.max(0.25, Math.min(2.5, bw / MAP_W));
        bleed(0);
    } else {
        zoom = Math.max(0.25, Math.min(2.5, bh / MAP_H, bw / MAP_W));
        bleed(Math.max(0, (bw / zoom - MAP_W) / 2));
    }
    fitZoom = zoom;
    applyZoom();
    scroller.scrollLeft = 0;
    scroller.scrollTop = 0;
    placeLabels();   // what is on screen changed (box size, Buildings switch): re-check who covers whom
}

window.addEventListener("resize", fit);

document.getElementById("zin").addEventListener("click", function () {
    zoom = Math.min(2.5, zoom + 0.25);
    applyZoom();
});

document.getElementById("zout").addEventListener("click", function () {
    zoom = Math.max(0.25, zoom - 0.25);
    applyZoom();
});

