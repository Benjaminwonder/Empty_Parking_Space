    root.setAttribute("class", "lot-svg");
    parent.appendChild(root);

    el("rect", { x: x0, y: y0, width: x1 - x0, height: y1 - y0, fill: "#cfe3c1" }, root);

    el("rect", { x: x0, y: y0, width: x1 - x0, height: LOT_ROAD_Y + ROAD_HALF - y0,
                 fill: "#9aa0a6" }, root);
    el("line", { x1: x0, y1: LOT_ROAD_Y, x2: x1, y2: LOT_ROAD_Y, stroke: "#ffffff", "stroke-width": 2,
                 "stroke-dasharray": "14 12", opacity: 0.7 }, root);
    el("text", { x: x0 + 12, y: y0 + 17, "class": "road-label", "text-anchor": "start",
                 "font-size": 12 }, root, "ENTRANCE ROAD");

    el("rect", { x: z.x - LOT_PAD, y: z.y - LOT_PAD, width: z.w + 2 * LOT_PAD,
                 height: z.h + 2 * LOT_PAD, rx: 12, fill: "#8d9299", stroke: "#6b7280",
                 "stroke-width": 3 }, root);

    el("rect", { x: z.x, y: LOT_ROAD_Y + ROAD_HALF - 2, width: LANE_W,
                 height: (z.y + z.h) - (LOT_ROAD_Y + ROAD_HALF - 2), fill: "#8d9299" }, root);
    el("line", { x1: z.laneX, y1: LOT_ROAD_Y + ROAD_HALF, x2: z.laneX, y2: z.y + z.h,
                 stroke: "#ffffff", "stroke-width": 2, "stroke-dasharray": "10 10",
                 opacity: 0.6 }, root);

    z.aisles.forEach(function (a) {
        el("rect", { x: z.x + LANE_W - 6, y: a.y - AISLE_H / 2, width: z.w - LANE_W + 12,
                     height: AISLE_H, fill: "#7d838a" }, root);
        el("line", { x1: z.x + LANE_W, y1: a.y, x2: z.x + z.w, y2: a.y, stroke: "#ffffff",
                     "stroke-width": 2, "stroke-dasharray": "10 10", opacity: 0.6 }, root);
    });

    const nodes = {};
    z.ids.forEach(function (id) {
        const st = stalls[id];
        const g = el("g", { "class": "stall type-" + st.type.toLowerCase() + " " +
