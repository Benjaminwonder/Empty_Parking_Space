public class WebPage {

    static int myPort = 8085;

    static class Stall {
        String id;
        String zone;
        String row;
        int number;
        boolean ada;
        boolean ev;

        Stall(String id, String zone, String row, int number,
              boolean ada, boolean ev) {
            this.id = id;
            this.zone = zone;
            this.row = row;
            this.number = number;
            this.ada = ada;
            this.ev = ev;
        }
    }

    static class Layout {
        String lotId;
        String utcOffset = "+00:00";  // campus.json's lot-local offset; the page shows times in it
        List<Stall> stalls = new ArrayList<>();
        // lot_id -> display name, in campus.json order (each lot becomes one pin on the map)
        Map<String, String> lotNames = new LinkedHashMap<>();
    }

    public static void main(String[] args) throws Exception {

        // campus.json: the nine lots everyone reads (BD-1). Edited by BD at the lead's request, 2026-10-12.
        Layout layout = loadLayout("campus.json");

        String page = buildPage(layout);

        HttpServer server = HttpServer.create(
                new InetSocketAddress(myPort), 0);

        server.createContext("/", new MyHandler(page));
        server.start();

        long adaCount = layout.stalls.stream().filter(s -> s.ada).count();
        long evCount = layout.stalls.stream().filter(s -> s.ev).count();

        System.out.println("ParkFind WebPage running at http://localhost:" + myPort);
        System.out.println("Layout: " + layout.lotId + " (" + layout.lotNames.size() + " lots)");
        System.out.println("Stalls loaded: " + layout.stalls.size()
                + " (ADA " + adaCount + ", EV " + evCount + ")");
    }

    static class MyHandler implements HttpHandler {

        private String page;

        MyHandler(String page) {
            this.page = page;
        }

        @Override
        public void handle(HttpExchange exchange) throws IOException {

            byte[] response =
                    page.getBytes(StandardCharsets.UTF_8);

            exchange.getResponseHeaders().set(
                    "Content-Type",
                    "text/html; charset=utf-8");

            exchange.sendResponseHeaders(
                    200,
                    response.length);

            exchange.getResponseBody().write(response);
            exchange.getResponseBody().close();
        }
    }

    static Layout loadLayout(String filename) throws IOException {

        String json = Files.readString(Path.of(filename));

        Layout layout = new Layout();

        Matcher campusMatcher = Pattern.compile(
                "\"campus_id\"\\s*:\\s*\"([^\"]+)\"")
                .matcher(json);

        if (campusMatcher.find()) {
            layout.lotId = campusMatcher.group(1);
        }
        Matcher offsetMatcher = Pattern.compile("\"utc_offset\"\\s*:\\s*\"([^\"]+)\"").matcher(json);
        if (offsetMatcher.find()) {
            layout.utcOffset = offsetMatcher.group(1);
        }

        // Each lot is one object starting at "lot_id". Cut the text into one chunk per
        // lot, then read that lot's fields from its own chunk only, so one lot's ADA
        // list can never be read as another's.
        Matcher lotStart = Pattern.compile("\"lot_id\"\\s*:\\s*\"([^\"]+)\"").matcher(json);
        List<int[]> starts = new ArrayList<>();
        List<String> ids = new ArrayList<>();
        while (lotStart.find()) {
            starts.add(new int[] { lotStart.start() });
            ids.add(lotStart.group(1));
        }

        for (int i = 0; i < ids.size(); i++) {

            int from = starts.get(i)[0];
            int to = (i + 1 < ids.size()) ? starts.get(i + 1)[0] : json.length();
            String chunk = json.substring(from, to);
            String lotId = ids.get(i);

            Matcher name = Pattern.compile("\"name\"\\s*:\\s*\"([^\"]+)\"").matcher(chunk);
            layout.lotNames.put(lotId, name.find() ? name.group(1) : lotId);

            Matcher perRow = Pattern.compile("\"stalls_per_row\"\\s*:\\s*([0-9]+)").matcher(chunk);
            if (!perRow.find()) {
                throw new IOException("lot " + lotId + " has no stalls_per_row in " + filename);
            }
            int stallsPerRow = Integer.parseInt(perRow.group(1));

            List<String> rows = getStringArray(chunk, "rows");
            List<String> adaStalls = getStringArray(chunk, "ada");
            List<String> evStalls = getStringArray(chunk, "ev");

            for (String row : rows) {
                for (int number = 1; number <= stallsPerRow; number++) {

                    // ids match the simulator and the server exactly: lot:row-NN
                    String local = String.format("%s-%02d", row, number);
                    String id = lotId + ":" + local;

                    layout.stalls.add(
                            new Stall(
                                    id,
                                    lotId,
                                    lotId + ":" + row,
                                    number,
                                    adaStalls.contains(local),
                                    evStalls.contains(local)));
                }
            }
        }

        if (layout.stalls.isEmpty()) {
            throw new IOException(
                    "No stalls found in " + filename
                    + " - expected campus.json with a lots list");
        }

        return layout;
    }

    static List<String> getStringArray(
            String json,
            String key) {

        List<String> values = new ArrayList<>();

        Pattern pattern = Pattern.compile(
                "\"" + key +
                "\"\\s*:\\s*\\[([^\\]]*)\\]");

        Matcher matcher = pattern.matcher(json);

        if (!matcher.find()) {
            return values;
        }

        Matcher valueMatcher = Pattern.compile(
                "\"([^\"]+)\"")
                .matcher(matcher.group(1));

        while (valueMatcher.find()) {
            values.add(valueMatcher.group(1));
        }

        return values;
    }

    static String esc(String s) {
        return s.replace("\\", "\\\\").replace("\"", "\\\"");
    }

    static String buildLayoutJson(Layout layout) {

        Map<String, Map<String, List<Stall>>> zones = new LinkedHashMap<>();

        for (Stall stall : layout.stalls) {
            zones.computeIfAbsent(stall.zone, k -> new LinkedHashMap<>())
                    .computeIfAbsent(stall.row, k -> new ArrayList<>())
                    .add(stall);
        }

        List<String> zoneJson = new ArrayList<>();

        for (Map.Entry<String, Map<String, List<Stall>>> zone : zones.entrySet()) {

            List<String> rowJson = new ArrayList<>();

            for (Map.Entry<String, List<Stall>> row : zone.getValue().entrySet()) {

                List<String> stallJson = new ArrayList<>();

                for (Stall stall : row.getValue()) {

                    String type = "Regular";
                    if (stall.ada) {
                        type = "ADA";
                    }
                    if (stall.ev) {
                        type = "EV";
                    }

                    stallJson.add("{\"id\":\"" + esc(stall.id) + "\","
                            + "\"n\":" + stall.number + ","
                            + "\"t\":\"" + type + "\"}");
                }

                rowJson.add("{\"id\":\"" + esc(row.getKey()) + "\","
                        + "\"stalls\":[" + String.join(",", stallJson) + "]}");
            }

            zoneJson.add("{\"id\":\"" + esc(zone.getKey()) + "\","
                    + "\"name\":\"" + esc(layout.lotNames.getOrDefault(zone.getKey(), zone.getKey())) + "\","
                    + "\"rows\":[" + String.join(",", rowJson) + "]}");
        }

        return "{\"lot\":\"" + esc(layout.lotId) + "\","
                + "\"utc_offset\":\"" + esc(layout.utcOffset) + "\","
                + "\"zones\":[" + String.join(",", zoneJson) + "]}";
    }

