function formatAge(ageSeconds) {
    if (ageSeconds === undefined || ageSeconds === null) {
        return "";
    }
    if (ageSeconds < 60) {
        return Math.round(ageSeconds) + "s ago";
    }
    if (ageSeconds < 3600) {
        return Math.round(ageSeconds / 60) + "m ago";
    }
    return Math.round(ageSeconds / 3600) + "h ago";
}

// as_of is UTC; drivers read campus time. Fixed offset from campus.json, like the rest of the trunk.
function campusClock(iso) {
    const t = Date.parse(iso.replace(/(\\.\\d{3})\\d+/, "$1"));
    const m = /^([+-])(\\d{2}):(\\d{2})$/.exec(LAYOUT.utc_offset || "+00:00");
    const offMin = (m[1] === "-" ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3]));
    const d = new Date(t + offMin * 60000);
    const hr = d.getUTCHours();
    const mm = String(d.getUTCMinutes()).padStart(2, "0");
    return ((hr + 11) % 12 + 1) + ":" + mm + " " + (hr < 12 ? "AM" : "PM");
}

