package parkfind;

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpServer;

import java.io.IOException;
import java.net.InetSocketAddress;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class WebPage {

    // port 8085: Benjamin's handoff note and CONTRACT.md say the server moved here
    static int myPort = 8085;

    // one parking spot. everything in here comes from the layout file (L0),
    // nothing is typed in by hand and nothing is random anymore
    static class Stall {
        String id;
        String zone;
        String row;
        int number;
        boolean ada;
        boolean ev;

        Stall(String id, String zone, String row, int number,
              boolean ada, boolean ev) {
            this.id = id;
            this.zone = zone;
            this.row = row;
            this.number = number;
            this.ada = ada;
            this.ev = ev;
        }
    }

    // the whole lot: its name plus every stall in the order they're read
    static class Layout {
        String lotId;
        List<Stall> stalls = new ArrayList<>();
    }

    public static void main(String[] args) throws Exception {

        // read the layout file first. run this from the project root because
        // the path is relative (the json sits next to sim.py)
        Layout layout = loadLayout("lot_commuter_north.json");

        // build the html one time at startup since the layout doesn't change
        String page = buildPage(layout);

        HttpServer server = HttpServer.create(
                new InetSocketAddress(myPort), 0);

        // "/" is the only route, every request just gets the page back
        server.createContext("/", new MyHandler(page));
        server.start();

        // quick check against BD-1: should say 120 stalls, 5 ADA, 8 EV
        long adaCount = layout.stalls.stream().filter(s -> s.ada).count();
        long evCount = layout.stalls.stream().filter(s -> s.ev).count();

        System.out.println("ParkFind WebPage running at http://localhost:" + myPort);
        System.out.println("Layout: " + layout.lotId);
        System.out.println("Stalls loaded: " + layout.stalls.size()
                + " (ADA " + adaCount + ", EV " + evCount + ")");
    }

    // sends the finished page to the browser. it doesn't think about
    // anything, it just hands over the html string
    static class MyHandler implements HttpHandler {

        private String page;

        MyHandler(String page) {
            this.page = page;
        }

        @Override
        public void handle(HttpExchange exchange) throws IOException {

            byte[] response =
                    page.getBytes(StandardCharsets.UTF_8);

            exchange.getResponseHeaders().set(
                    "Content-Type",
                    "text/html; charset=utf-8");

            exchange.sendResponseHeaders(
                    200,
                    response.length);

            exchange.getResponseBody().write(response);
            exchange.getResponseBody().close();
        }
    }

    // DK-2: turn lot_commuter_north.json into stall objects.
    // no stall id or ADA/EV spot is written in this file, it all comes from here.
    // I'm using regex instead of a json library because we're standard
    // library only (D1)
    static Layout loadLayout(String filename) throws IOException {

        String json = Files.readString(Path.of(filename));

        Layout layout = new Layout();

        // grab the lot name (lot_id)

        Matcher lotMatcher = Pattern.compile(
                "\"lot_id\"\\s*:\\s*\"([^\"]+)\"")
                .matcher(json);

        if (lotMatcher.find()) {
            layout.lotId = lotMatcher.group(1);
        }

        // the ADA and EV lists from special_stalls, used later to mark stalls
        List<String> adaStalls =
                getStringArray(json, "ada");

        List<String> evStalls =
                getStringArray(json, "ev");

        // matches one zone block. heads up: the keys have to be in this exact
        // order (zone_id, fill_priority, rows, stalls_per_row) or it finds
        // nothing, so if Benjamin changes the json order this breaks
        Pattern zonePattern = Pattern.compile(
                "\\{\\s*" +
                "\"zone_id\"\\s*:\\s*\"([^\"]+)\"\\s*," +
                "\\s*\"fill_priority\"\\s*:\\s*([0-9]+)\\s*," +
                "\\s*\"rows\"\\s*:\\s*\\[([^\\]]+)\\]\\s*," +
                "\\s*\"stalls_per_row\"\\s*:\\s*([0-9]+)" +
                "\\s*\\}");

        Matcher zoneMatcher = zonePattern.matcher(json);

        // go through each zone (near, mid, far)
        while (zoneMatcher.find()) {

            String zone = zoneMatcher.group(1);
            String rowsText = zoneMatcher.group(3);
            int stallsPerRow =
                    Integer.parseInt(zoneMatcher.group(4));

            // pull the row names out of the rows list, like N1, N2...
            Matcher rowMatcher = Pattern.compile(
                    "\"([^\"]+)\"")
                    .matcher(rowsText);

            while (rowMatcher.find()) {

                String row = rowMatcher.group(1);

                // every row has stalls_per_row stalls, so count 1 up to that.
                // %02d makes it 01 not 1, so ids look like N1-01
                for (int number = 1;
                     number <= stallsPerRow;
                     number++) {

                    String id = String.format(
                            "%s-%02d",
                            row,
                            number);

                    // a stall is ADA/EV only if the layout file lists its id
                    boolean ada =
                            adaStalls.contains(id);

                    boolean ev =
                            evStalls.contains(id);

                    layout.stalls.add(
                            new Stall(
                                    id,
                                    zone,
                                    row,
                                    number,
                                    ada,
                                    ev));
                }
            }
        }

        // if nothing loaded the regex probably didn't match the file, so stop
        // loudly instead of showing an empty lot (and don't make up stalls)
        if (layout.stalls.isEmpty()) {
            throw new IOException(
                    "No stalls found in " + filename
                    + " - check the zone keys are in the expected order");
        }

        return layout;
    }

    // finds "key": [ "a", "b" ] in the json and gives back a list of the
    // strings. returns an empty list if the key isn't there
    static List<String> getStringArray(
            String json,
            String key) {

        List<String> values = new ArrayList<>();

        Pattern pattern = Pattern.compile(
                "\"" + key +
                "\"\\s*:\\s*\\[([^\\]]*)\\]");

        Matcher matcher = pattern.matcher(json);

        if (!matcher.find()) {
            return values;
        }

        Matcher valueMatcher = Pattern.compile(
                "\"([^\"]+)\"")
                .matcher(matcher.group(1));

        while (valueMatcher.find()) {
            values.add(valueMatcher.group(1));
        }

        return values;
    }

    // makes a string safe to put inside "quotes" in the json I hand to the page
    static String esc(String s) {
        return s.replace("\\", "\\\\").replace("\"", "\\\"");
    }

    // turns the layout into a small json string for the page's javascript.
    // shape: {lot, zones:[{id, rows:[{id, stalls:[{id, n, t}]}]}]}
    // t is Regular / ADA / EV. this is the ONLY place the page gets stalls from,
    // so the map draws exactly what the layout file says (X5 stays dead)
    static String buildLayoutJson(Layout layout) {

        // group the flat stall list into zone -> row -> stalls, keeping the
        // same order the file had them in
        Map<String, Map<String, List<Stall>>> zones = new LinkedHashMap<>();

        for (Stall stall : layout.stalls) {
            zones.computeIfAbsent(stall.zone, k -> new LinkedHashMap<>())
                    .computeIfAbsent(stall.row, k -> new ArrayList<>())
                    .add(stall);
        }

        List<String> zoneJson = new ArrayList<>();

        for (Map.Entry<String, Map<String, List<Stall>>> zone : zones.entrySet()) {

            List<String> rowJson = new ArrayList<>();

            for (Map.Entry<String, List<Stall>> row : zone.getValue().entrySet()) {

                List<String> stallJson = new ArrayList<>();

                for (Stall stall : row.getValue()) {

                    // same rule as before: EV wins if a stall is in both lists
                    String type = "Regular";
                    if (stall.ada) {
                        type = "ADA";
                    }
                    if (stall.ev) {
                        type = "EV";
                    }

                    stallJson.add("{\"id\":\"" + esc(stall.id) + "\","
                            + "\"n\":" + stall.number + ","
                            + "\"t\":\"" + type + "\"}");
                }

                rowJson.add("{\"id\":\"" + esc(row.getKey()) + "\","
                        + "\"stalls\":[" + String.join(",", stallJson) + "]}");
            }

            zoneJson.add("{\"id\":\"" + esc(zone.getKey()) + "\","
                    + "\"rows\":[" + String.join(",", rowJson) + "]}");
        }

        return "{\"lot\":\"" + esc(layout.lotId) + "\","
                + "\"zones\":[" + String.join(",", zoneJson) + "]}";
    }

    // makes the whole html page as one string.
    // the page only draws what the layout says. it doesn't decide whether a
    // spot is free or taken (that's DK-3 and comes from SK-VIEW), so every
    // stall is gray / unknown for now. I did NOT copy the made up 12/20 numbers
    // from the mockup because that would be inventing occupancy
    static String buildPage(Layout layout) {

