<script>

// the layout from lot_commuter_north.json, put here by the java code
const LAYOUT = __LAYOUT_JSON__;

const SVGNS = "http://www.w3.org/2000/svg";

// ---------- sizes. all numbers are map units, 10 units = 1 meter ----------
const PX_PER_M = 10;
const STALL_W = 24;      // stall width
const STALL_STEP = 26;   // stall width + a small gap
const STALL_H = 32;      // stall depth
const AISLE_H = 30;      // the lane between two rows
const PAIR_GAP = 10;     // little gap between one pair of rows and the next
const PAIR_H = STALL_H + AISLE_H + STALL_H;
const GATE_X = 85;       // the main drive runs down from the gate at x = 85
const GATE_Y = 40;
const BLOCK_X = 140;     // where every lot starts from the left
const ZONE_GAP = 78;     // space between lots (has to fit the P pill)

// small helper: make an svg element, set its attributes, add it to a parent
function el(tag, attrs, parent, text) {
    const e = document.createElementNS(SVGNS, tag);
    for (const k in attrs) {
        e.setAttribute(k, attrs[k]);
    }
    if (text !== undefined) {
        e.textContent = text;
    }
    if (parent) {
        parent.appendChild(e);
    }
    return e;
}

function cap(s) {
    return s.charAt(0).toUpperCase() + s.slice(1);
}

function dist(a, b) {
    return Math.hypot(b[0] - a[0], b[1] - a[1]);
}

// ---------- 1. work out where everything goes (from the layout only) ----------

// stalls by id so clicking / searching can find them fast
const stalls = {};
const zones = [];

let cursorY = 110;       // where the next lot starts (top has the road + pill)
let widest = 0;

LAYOUT.zones.forEach(function (zone) {

    if (zone.rows.length === 0) {
        return;
    }

    let perRow = 0;
    zone.rows.forEach(function (r) {
        perRow = Math.max(perRow, r.stalls.length);
    });

    // rows go in pairs with an aisle between them (row 1 + row 2, row 3 + row 4)
    const pairs = Math.ceil(zone.rows.length / 2);
    const height = pairs * PAIR_H + (pairs - 1) * PAIR_GAP;
    const width = perRow * STALL_STEP - (STALL_STEP - STALL_W);

    const z = {
        id: zone.id,
        rows: zone.rows,
        x: BLOCK_X,
        y: cursorY,
        w: width,
        h: height,
        pairs: pairs,
        aisles: []
    };

    for (let p = 0; p < pairs; p++) {
        const pairTop = cursorY + p * (PAIR_H + PAIR_GAP);
        z.aisles.push({
            y: pairTop + STALL_H + AISLE_H / 2,
            rowA: zone.rows[2 * p].id,
            rowB: zone.rows[2 * p + 1] ? zone.rows[2 * p + 1].id : null
        });
    }

    zone.rows.forEach(function (row, ri) {
        const pair = Math.floor(ri / 2);
        const second = (ri % 2 === 1);
        const pairTop = cursorY + pair * (PAIR_H + PAIR_GAP);

        row.stalls.forEach(function (s, si) {
            stalls[s.id] = {
                id: s.id,
                n: s.n,
                type: s.t,
                zone: z,
                row: row.id,
                pair: pair,
                x: BLOCK_X + si * STALL_STEP,
                y: pairTop + (second ? STALL_H + AISLE_H : 0),
                aisleY: z.aisles[pair].y,
                belowAisle: second      // second row of a pair sits under the aisle
            };
        });
    });

    zones.push(z);
    widest = Math.max(widest, width);
    cursorY += height + ZONE_GAP;
});

const MAP_W = Math.max(1200, BLOCK_X + widest + 640);
const MAP_H = cursorY - ZONE_GAP + 70;

// ---------- 2. draw the map background (just scenery) ----------

const svg = document.getElementById("map");
svg.setAttribute("viewBox", "0 0 " + MAP_W + " " + MAP_H);

// places where trees must not go (roads, lots, buildings...)
const solid = [];

function keepClear(x, y, w, h) {
    solid.push([x - 8, y - 8, w + 16, h + 16]);
}

// grass
el("rect", { x: 0, y: 0, width: MAP_W, height: MAP_H, fill: "#d4e5c9" }, svg);

// slightly lighter lawn patches so it isn't one flat green
const lawns = el("g", {}, svg);
el("ellipse", { cx: MAP_W - 380, cy: 260, rx: 190, ry: 120, fill: "#dcebd2" }, lawns);
el("ellipse", { cx: MAP_W - 500, cy: MAP_H - 200, rx: 220, ry: 110, fill: "#dcebd2" }, lawns);

const treeLayer = el("g", {}, svg);   // filled in after we know what to avoid
const roadLayer = el("g", {}, svg);
const lotLayer = el("g", {}, svg);
const bldgLayer = el("g", {}, svg);
const stallLayer = el("g", {}, svg);
const routeLayer = el("g", { "pointer-events": "none" }, svg);

// the road across the top and the main drive down the left side
el("rect", { x: 0, y: 0, width: MAP_W, height: 38, fill: "#9aa0a6" }, roadLayer);
el("rect", { x: 0, y: 36, width: MAP_W, height: 3, fill: "#ffffff", opacity: 0.8 }, roadLayer);
el("text", { x: MAP_W / 2, y: 24, class: "road-label", "text-anchor": "middle" },
   roadLayer, "MAIN ROAD");
keepClear(0, 0, MAP_W, 40);

el("rect", { x: GATE_X - 15, y: 38, width: 30, height: MAP_H - 38, fill: "#9aa0a6" }, roadLayer);
el("line", { x1: GATE_X, y1: 40, x2: GATE_X, y2: MAP_H, stroke: "#ffffff",
             "stroke-width": 2, "stroke-dasharray": "10 10", opacity: 0.8 }, roadLayer);
keepClear(GATE_X - 15, 38, 30, MAP_H);

// the right side: some buildings and walkways (decoration, not from the layout)
const bx = BLOCK_X + widest + 100;

const buildings = [
    { x: bx,       y: 100, w: 230, h: 150, label: "Campus Core" },
    { x: bx + 270, y: 100, w: 170, h: 110, label: "" },
    { x: bx,       y: 320, w: 150, h: 110, label: "" },
    { x: bx + 200, y: 300, w: 220, h: 140, label: "" },
    { x: bx + 40,  y: 530, w: 190, h: 110, label: "" },
    { x: bx + 300, y: 520, w: 150, h: 120, label: "" }
];

// walkways from each lot over to the buildings
const walks = el("g", {}, roadLayer);
el("rect", { x: bx - 40, y: 90, width: 9, height: MAP_H - 150, fill: "#efe9dd" }, walks);
keepClear(bx - 40, 90, 9, MAP_H - 150);

zones.forEach(function (z) {
    const wy = z.y + z.h / 2 - 4;
    el("rect", { x: z.x + z.w + 10, y: wy, width: bx - (z.x + z.w + 10) - 31,
                 height: 9, fill: "#efe9dd" }, walks);
    keepClear(z.x + z.w + 10, wy, bx - (z.x + z.w + 10), 9);
});

buildings.forEach(function (b) {
    if (b.y + b.h > MAP_H - 20) {
        return;
    }
    el("rect", { x: b.x + 4, y: b.y + 5, width: b.w, height: b.h, rx: 6,
                 fill: "#000000", opacity: 0.12 }, bldgLayer);
    el("rect", { x: b.x, y: b.y, width: b.w, height: b.h, rx: 6,
                 fill: "#e3d9cc", stroke: "#b9ac9a", "stroke-width": 2 }, bldgLayer);
    el("rect", { x: b.x + 14, y: b.y + 14, width: b.w - 28, height: b.h - 28, rx: 4,
                 fill: "#cfc3b2" }, bldgLayer);
    if (b.label !== "") {
        el("text", { x: b.x + b.w / 2, y: b.y + b.h / 2 + 5, class: "label" },
           bldgLayer, b.label);
    }
    keepClear(b.x, b.y, b.w, b.h);
});

// the lots themselves: pavement, lanes, and the "P" marker pill above each one
zones.forEach(function (z) {

    // pavement under the whole lot
    el("rect", { x: z.x - 12, y: z.y - 10, width: z.w + 24, height: z.h + 20, rx: 10,
                 fill: "#8d9299", stroke: "#ffffff", "stroke-width": 2 }, lotLayer);
    keepClear(z.x - 12, z.y - 10, z.w + 24, z.h + 20);

    z.aisles.forEach(function (a) {
        // lane from the main drive into the lot
        el("rect", { x: GATE_X + 15, y: a.y - AISLE_H / 2, width: z.x - (GATE_X + 15) + 6,
                     height: AISLE_H, fill: "#8d9299" }, lotLayer);
        // darker aisle with a dashed center line
        el("rect", { x: z.x - 6, y: a.y - AISLE_H / 2, width: z.w + 12, height: AISLE_H,
                     fill: "#868b92" }, lotLayer);
        el("line", { x1: z.x, y1: a.y, x2: z.x + z.w, y2: a.y, stroke: "#ffffff",
                     "stroke-width": 1.5, "stroke-dasharray": "8 8", opacity: 0.6 }, lotLayer);
        keepClear(GATE_X + 15, a.y - AISLE_H / 2, z.x - GATE_X, AISLE_H);
    });

    // marker pill like the mockup: green-ish P circle + name. it's gray because
    // we don't know the counts yet (no fake 12/20 numbers)
    const count = z.rows.reduce(function (sum, r) { return sum + r.stalls.length; }, 0);
    const label = cap(z.id) + " lot · " + count + " stalls";
    const pw = 40 + label.length * 7;
    const pg = el("g", {}, lotLayer);
    el("rect", { x: z.x - 12, y: z.y - 44, width: pw, height: 28, rx: 14,
                 fill: "#ffffff", stroke: "#9ca3af", "stroke-width": 1.5 }, pg);
    el("circle", { cx: z.x + 4, cy: z.y - 30, r: 11, fill: "#6b7280" }, pg);
    el("text", { x: z.x + 4, y: z.y - 25, "text-anchor": "middle", fill: "#ffffff",
                 "font-size": 14, "font-weight": "bold" }, pg, "P");
    el("text", { x: z.x + 22, y: z.y - 25, class: "pill-text" }, pg, label);
    keepClear(z.x - 12, z.y - 44, pw, 28);
});

// the gate marker at the top of the main drive
const gate = el("g", {}, lotLayer);
el("circle", { cx: GATE_X, cy: GATE_Y, r: 12, fill: "#ffffff", stroke: "#14532d",
               "stroke-width": 3 }, gate);
el("text", { x: GATE_X + 20, y: GATE_Y + 5, "font-size": 13, "font-weight": "bold",
             fill: "#14532d" }, gate, "Main Gate");

// trees: no Random here either. the spots come from a fixed formula so the
// map looks the same every time
for (let i = 0; i < 260; i++) {
    const tx = (i * 149 + 53) % MAP_W;
    const ty = (i * 97 + i * i * 13) % MAP_H;
    let blocked = false;
    for (let k = 0; k < solid.length; k++) {
        const s = solid[k];
        if (tx > s[0] && tx < s[0] + s[2] && ty > s[1] && ty < s[1] + s[3]) {
            blocked = true;
            break;
        }
    }
    if (!blocked) {
        const r = 9 + (i % 4) * 2;
        el("circle", { cx: tx + 2, cy: ty + 3, r: r, fill: "#000000", opacity: 0.1 }, treeLayer);
        el("circle", { cx: tx, cy: ty, r: r, fill: (i % 3 === 0 ? "#7fae6e" : "#8fbb7d") }, treeLayer);
    }
}

// ---------- 3. draw every stall from the layout ----------

const ICON_ADA = String.fromCharCode(9855);   // wheelchair symbol
const ICON_EV = String.fromCharCode(9889);    // lightning bolt

Object.keys(stalls).forEach(function (id) {
    const st = stalls[id];
    const typeClass = "type-" + st.type.toLowerCase();

    // data-id / data-zone / data-type are for DK-3 to find a stall and paint it
    const g = el("g", { "class": "stall " + typeClass + " unknown",
                        "data-id": st.id, "data-zone": st.zone.id,
                        "data-type": st.type }, stallLayer);

    el("title", {}, g, st.id + " · " + st.type + " · " + cap(st.zone.id) + " lot · status unknown");
    el("rect", { x: st.x, y: st.y, width: STALL_W, height: STALL_H, rx: 3,
                 "class": "stall-rect" }, g);

    const num = (st.n < 10 ? "0" : "") + st.n;

    if (st.type === "Regular") {
        el("text", { x: st.x + STALL_W / 2, y: st.y + STALL_H / 2 + 3, "class": "stall-num" }, g, num);
    } else {
        el("text", { x: st.x + STALL_W / 2, y: st.y + 14, "class": "stall-icon" },
           g, st.type === "ADA" ? ICON_ADA : ICON_EV);
        el("text", { x: st.x + STALL_W / 2, y: st.y + 27, "class": "stall-num" }, g, num);
    }

    st.node = g;
    g.addEventListener("click", function (ev) {
        ev.stopPropagation();
        selectStall(st.id);
    });
});

// ---------- 4. the route (like a maps app) ----------

let selectedId = null;

// the path's corners get rounded so it looks like a real route line
function roundedPath(pts, r) {
    let d = "M" + pts[0][0] + " " + pts[0][1];
    for (let i = 1; i < pts.length - 1; i++) {
        const p0 = pts[i - 1];
        const p1 = pts[i];
        const p2 = pts[i + 1];
        const l1 = dist(p0, p1);
        const l2 = dist(p1, p2);
        const rr = Math.min(r, l1 / 2, l2 / 2);
        const ax = p1[0] + (p0[0] - p1[0]) / l1 * rr;
        const ay = p1[1] + (p0[1] - p1[1]) / l1 * rr;
        const bx2 = p1[0] + (p2[0] - p1[0]) / l2 * rr;
        const by2 = p1[1] + (p2[1] - p1[1]) / l2 * rr;
        d += " L" + ax + " " + ay + " Q" + p1[0] + " " + p1[1] + " " + bx2 + " " + by2;
    }
    const last = pts[pts.length - 1];
    d += " L" + last[0] + " " + last[1];
    return d;
}

// left or right? y goes DOWN on the screen so the sign is flipped
function turnWord(h, t) {
    const cross = h[0] * t[1] - h[1] * t[0];
    return cross < 0 ? "left" : "right";
}

function unit(a, b) {
    const l = dist(a, b);
    return [(b[0] - a[0]) / l, (b[1] - a[1]) / l];
}

function meters(a, b) {
    return Math.round(dist(a, b) / PX_PER_M);
}

// the drawn path: main gate -> down the main drive -> into the lot's aisle ->
// along the aisle -> into the stall. it's only a drawing of the way in,
// the real guidance (which stall to send someone to) is T4's job
function routeFor(st) {
    const sx = st.x + STALL_W / 2;
    const sy = st.y + STALL_H / 2;

    const pts = [
        [GATE_X, GATE_Y],
        [GATE_X, st.aisleY],
        [sx, st.aisleY],
        [sx, sy]
    ];

    // drop doubled points so nothing has zero length
    const clean = [pts[0]];
    for (let i = 1; i < pts.length; i++) {
        if (dist(clean[clean.length - 1], pts[i]) > 0.5) {
            clean.push(pts[i]);
        }
    }
    return clean;
}

function stepsFor(st, pts) {
    const aisle = st.zone.aisles[st.pair];
    const between = aisle.rowB ? "between rows " + aisle.rowA + " and " + aisle.rowB
                               : "beside row " + aisle.rowA;

    const steps = ["Start at the Main Gate."];

    // pts: gate, bend (main drive -> aisle), end of aisle, stall
    const gateToBend = pts[1];
    steps.push("Head straight down the main drive for " + meters(pts[0], gateToBend) + " m.");

    const h1 = unit(pts[0], pts[1]);
    const t1 = unit(pts[1], pts[2]);
    steps.push("Turn " + turnWord(h1, t1) + " into the " + cap(st.zone.id) +
               " lot, onto the aisle " + between + ".");
    steps.push("Follow the aisle for " + meters(pts[1], pts[2]) + " m.");

    const t2 = unit(pts[2], pts[3]);
    let note = "";
    if (st.type === "ADA") {
        note = " (ADA stall)";
    }
    if (st.type === "EV") {
        note = " (EV charging stall)";
    }
    steps.push(st.id + " is on your " + turnWord(t1, t2) + note + ".");
    return steps;
}

function clearRoute() {
    selectedId = null;
    while (routeLayer.firstChild) {
        routeLayer.removeChild(routeLayer.firstChild);
    }
    Object.keys(stalls).forEach(function (id) {
        stalls[id].node.classList.remove("selected");
    });
    showHelp();
}

function selectStall(id) {
    const st = stalls[id];
    if (!st) {
        return;
    }

    clearRouteQuiet();
    selectedId = id;
    st.node.classList.add("selected");

    const pts = routeFor(st);
    const d = roundedPath(pts, 14);

    // white outline, blue line, then moving dashes on top
    el("path", { d: d, fill: "none", stroke: "#ffffff", "stroke-width": 10,
                 "stroke-linecap": "round", "stroke-linejoin": "round" }, routeLayer);
    el("path", { d: d, fill: "none", stroke: "#1a73e8", "stroke-width": 6,
                 "stroke-linecap": "round", "stroke-linejoin": "round" }, routeLayer);
    el("path", { d: d, fill: "none", stroke: "#ffffff", "stroke-width": 2,
                 "stroke-linecap": "round", "class": "route-flow", opacity: 0.8 }, routeLayer);

    // start dot at the gate
    el("circle", { cx: pts[0][0], cy: pts[0][1], r: 9, fill: "#ffffff",
                   stroke: "#1a73e8", "stroke-width": 4 }, routeLayer);

    // red pin on the stall
    const end = pts[pts.length - 1];
    const pin = el("g", { transform: "translate(" + end[0] + " " + (end[1] - 4) + ")" }, routeLayer);
    el("path", { d: "M0 0 C-14 -16 -12 -34 0 -34 C12 -34 14 -16 0 0 Z", fill: "#d93025",
                 stroke: "#ffffff", "stroke-width": 2 }, pin);
    el("circle", { cx: 0, cy: -22, r: 4.5, fill: "#ffffff" }, pin);

    showRoute(st, pts);
    scrollToStall(st);
}

// same as clearRoute but doesn't redraw the help panel (selectStall redraws it)
function clearRouteQuiet() {
    while (routeLayer.firstChild) {
        routeLayer.removeChild(routeLayer.firstChild);
    }
    Object.keys(stalls).forEach(function (id) {
        stalls[id].node.classList.remove("selected");
    });
}

// ---------- 5. the side panel ----------

const side = document.getElementById("side");

function clearSide() {
    while (side.firstChild) {
        side.removeChild(side.firstChild);
    }
}

function add(tag, text, cls) {
    const e = document.createElement(tag);
    if (text !== undefined) {
        e.textContent = text;
    }
    if (cls) {
        e.className = cls;
    }
    side.appendChild(e);
    return e;
}

function legendRow(color, outline, text) {
    const row = document.createElement("div");
    row.className = "legend-row";
    const sw = document.createElement("div");
    sw.className = "sw";
    sw.style.background = color;
    sw.style.outlineColor = outline;
    row.appendChild(sw);
    row.appendChild(document.createTextNode(text));
    side.appendChild(row);
}

// what the panel says before anything is clicked
function showHelp() {
    clearSide();
    add("h2", LAYOUT.lot);
    add("div", "Click any stall to see the way in from the Main Gate.", "sub");

    legendRow("#cfd2d6", "#9ca3af", "Regular stall");
    legendRow("#c9d8f5", "#2563eb", "ADA stall");
    legendRow("#e1d3f5", "#7c3aed", "EV charging stall");

    add("div", "Every stall is gray because live free / taken data isn't connected " +
               "yet. Free and taken colors arrive with the live feed.", "status-note");
}

// what the panel says once a stall is picked
function showRoute(st, pts) {
    clearSide();

    add("h2", st.id);
    add("div", cap(st.zone.id) + " lot · row " + st.row + " · spot " + st.n, "sub");

    const badges = add("div");
    const b1 = document.createElement("span");
    b1.className = "badge" + (st.type === "ADA" ? " ada" : (st.type === "EV" ? " ev" : ""));
    b1.textContent = st.type;
    badges.appendChild(b1);

    let total = 0;
    for (let i = 1; i < pts.length; i++) {
        total += meters(pts[i - 1], pts[i]);
    }
    add("div", "about " + total + " m", "total");

    const ol = add("ol", undefined, "steps");
    stepsFor(st, pts).forEach(function (text) {
        const li = document.createElement("li");
        li.textContent = text;
        ol.appendChild(li);
    });

    add("div", "Live status: unknown. This shows the way to the stall, not whether " +
               "it's free. Check the live status once it's connected.", "status-note");

    const btn = add("button", "Clear route", "btn");
    btn.addEventListener("click", clearRoute);
}

// ---------- 6. filter chips + search (just dim stalls, no occupancy) ----------

let filter = "All";
let query = "";

function countType(t) {
    let c = 0;
    Object.keys(stalls).forEach(function (id) {
        if (stalls[id].type === t) {
            c++;
        }
    });
    return c;
}

const chipNames = [
    { key: "All", text: "All stalls" },
    { key: "Regular", text: "Regular (" + countType("Regular") + ")" },
    { key: "ADA", text: "ADA (" + countType("ADA") + ")" },
    { key: "EV", text: "EV Charging (" + countType("EV") + ")" }
];

const chipBox = document.getElementById("chips");

function drawChips() {
    while (chipBox.firstChild) {
        chipBox.removeChild(chipBox.firstChild);
    }
    chipNames.forEach(function (c) {
        const d = document.createElement("div");
        d.className = "chip" + (filter === c.key ? " on" : "");
        d.textContent = c.text;
        d.addEventListener("click", function () {
            filter = c.key;
            drawChips();
            applyDim();
        });
        chipBox.appendChild(d);
    });
}

function applyDim() {
    Object.keys(stalls).forEach(function (id) {
        const st = stalls[id];
        let dim = false;
        if (filter !== "All" && st.type !== filter) {
            dim = true;
        }
        if (query !== "" && id.toUpperCase().indexOf(query) < 0) {
            dim = true;
        }
        st.node.classList.toggle("dim", dim);
    });
}

const searchBox = document.getElementById("search");

searchBox.addEventListener("input", function () {
    query = searchBox.value.trim().toUpperCase();
    applyDim();
});

searchBox.addEventListener("keydown", function (ev) {
    if (ev.key === "Enter") {
        const wanted = searchBox.value.trim().toUpperCase();
        if (stalls[wanted]) {
            selectStall(wanted);
        }
    }
});

drawChips();

// ---------- 7. zoom + scrolling ----------

const scroller = document.getElementById("scroll");
let zoom = 1;

function applyZoom() {
    svg.setAttribute("width", Math.round(MAP_W * zoom));
    svg.setAttribute("height", Math.round(MAP_H * zoom));
}

function fit() {
    // make the whole map fit the box on load
    zoom = Math.max(0.4, Math.min(1.2, scroller.clientWidth / MAP_W));
    applyZoom();
    scroller.scrollLeft = 0;
    scroller.scrollTop = 0;
}

function scrollToStall(st) {
    const cx = (st.x + STALL_W / 2) * zoom;
    const cy = (st.y + STALL_H / 2) * zoom;
    scroller.scrollTo({
        left: Math.max(0, cx - scroller.clientWidth / 2),
        top: Math.max(0, cy - scroller.clientHeight / 2),
        behavior: "smooth"
    });
}

document.getElementById("zin").addEventListener("click", function () {
    zoom = Math.min(2.5, zoom + 0.25);
    applyZoom();
});

document.getElementById("zout").addEventListener("click", function () {
    zoom = Math.max(0.4, zoom - 0.25);
    applyZoom();
});

document.getElementById("zfit").addEventListener("click", fit);

// click empty map or press Esc to drop the route
svg.addEventListener("click", clearRoute);

document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape") {
        clearRoute();
    }
});

fit();
showHelp();

</script>

