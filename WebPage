const cards = [];

function passes(id) {
    const st = stalls[id];
    if (filter !== "All" && st.type !== filter) {
        return false;
    }
    if (query !== "" && normalSearch(id).indexOf(query) < 0 &&
        normalSearch(lotName(st.zone)).indexOf(query) < 0) {
        return false;
    }
    return true;
}

function lotDiagram(z, parent) {

    const x0 = z.x - LOT_PAD - 6;
    const x1 = z.x + z.w + LOT_PAD + 6;
    const y0 = LOT_ROAD_Y + ROAD_HALF - 46;
    const y1 = z.y + z.h + LOT_PAD + 6;

    const root = document.createElementNS(SVGNS, "svg");
    root.setAttribute("viewBox", x0 + " " + y0 + " " + (x1 - x0) + " " + (y1 - y0));
    root.setAttribute("class", "lot-svg");
    parent.appendChild(root);

    el("rect", { x: x0, y: y0, width: x1 - x0, height: y1 - y0, fill: "#cfe3c1" }, root);

    el("rect", { x: x0, y: y0, width: x1 - x0, height: LOT_ROAD_Y + ROAD_HALF - y0,
                 fill: "#9aa0a6" }, root);
    el("line", { x1: x0, y1: LOT_ROAD_Y, x2: x1, y2: LOT_ROAD_Y, stroke: "#ffffff", "stroke-width": 2,
                 "stroke-dasharray": "14 12", opacity: 0.7 }, root);
    el("text", { x: x0 + 12, y: y0 + 17, "class": "road-label", "text-anchor": "start",
                 "font-size": 12 }, root, "ENTRANCE ROAD");

    el("rect", { x: z.x - LOT_PAD, y: z.y - LOT_PAD, width: z.w + 2 * LOT_PAD,
                 height: z.h + 2 * LOT_PAD, rx: 12, fill: "#8d9299", stroke: "#6b7280",
                 "stroke-width": 3 }, root);

    el("rect", { x: z.x, y: LOT_ROAD_Y + ROAD_HALF - 2, width: LANE_W,
                 height: (z.y + z.h) - (LOT_ROAD_Y + ROAD_HALF - 2), fill: "#8d9299" }, root);
    el("line", { x1: z.laneX, y1: LOT_ROAD_Y + ROAD_HALF, x2: z.laneX, y2: z.y + z.h,
                 stroke: "#ffffff", "stroke-width": 2, "stroke-dasharray": "10 10",
                 opacity: 0.6 }, root);

    z.aisles.forEach(function (a) {
        el("rect", { x: z.x + LANE_W - 6, y: a.y - AISLE_H / 2, width: z.w - LANE_W + 12,
                     height: AISLE_H, fill: "#7d838a" }, root);
        el("line", { x1: z.x + LANE_W, y1: a.y, x2: z.x + z.w, y2: a.y, stroke: "#ffffff",
                     "stroke-width": 2, "stroke-dasharray": "10 10", opacity: 0.6 }, root);
    });

    const nodes = {};
    z.ids.forEach(function (id) {
        const st = stalls[id];
        const g = el("g", { "class": "stall type-" + st.type.toLowerCase() + " " +
                                     statusClass(statusOf(id)),
                            "data-id": id, "data-zone": z.id, "data-type": st.type }, root);

        el("title", {}, g, spotName(id) + (st.type !== "Regular" ? " (" + st.type + ")" : "") +
                           " · " + statusOf(id).replace("_", " "));
        el("rect", { x: st.x, y: st.y, width: STALL_W, height: STALL_H, rx: 5,
                     "class": "stall-rect" }, g);

        const num = (st.n < 10 ? "0" : "") + st.n;
        if (st.type === "Regular") {
            el("text", { x: st.x + STALL_W / 2, y: st.y + STALL_H / 2 + 4,
                         "class": "stall-num" }, g, num);
        } else {
            el("text", { x: st.x + STALL_W / 2, y: st.y + 15, "class": "stall-icon" },
               g, st.type === "ADA" ? ICON_ADA : ICON_EV);
            el("text", { x: st.x + STALL_W / 2, y: st.y + 30, "class": "stall-num" }, g, num);
        }

        if (!passes(id)) {
            g.classList.add("dim");
        }
        g.addEventListener("click", function () {
            selectSpot(id);
        });
        nodes[id] = g;
    });

    const routeG = el("g", { "pointer-events": "none" }, root);
    return { svg: root, nodes: nodes, routeG: routeG, x0: x0 };
}

const ICON_ADA = String.fromCharCode(9855);
const ICON_EV = String.fromCharCode(9889);

function drawLotRoute(card) {
    while (card.routeG.firstChild) {
        card.routeG.removeChild(card.routeG.firstChild);
    }
    if (route === null || stalls[route.id].zone !== card.z) {
        return;
    }
    const st = stalls[route.id];
    const z = card.z;
    const sx = st.x + STALL_W / 2;
    const sy = st.y + STALL_H / 2;
    const pts = [[card.x0 + 14, LOT_ROAD_Y], [z.laneX, LOT_ROAD_Y], [z.laneX, st.aisleY],
                 [sx, st.aisleY], [sx, sy]];
    const d = roundedPath(pts, 14);

    const g = el("g", { "class": route.started ? "route-g" : "route-g preview" }, card.routeG);
    el("path", { d: d, fill: "none", stroke: "#ffffff", "stroke-width": 11,
                 "stroke-linecap": "round", "stroke-linejoin": "round" }, g);
    el("path", { d: d, fill: "none", stroke: "#1a73e8", "stroke-width": 6,
                 "stroke-linecap": "round", "stroke-linejoin": "round" }, g);

    const pin = el("g", { transform: "translate(" + sx + " " + (sy - 4) + ") scale(1.2)" },
                   card.routeG);
    el("path", { d: "M0 0 C-14 -16 -12 -34 0 -34 C12 -34 14 -16 0 0 Z", fill: "#d93025",
                 stroke: "#ffffff", "stroke-width": 2 }, pin);
    el("circle", { cx: 0, cy: -22, r: 4.5, fill: "#ffffff" }, pin);
}

// why: lead the lot window with guidance's answer, worded at exactly the grain guidance gave
//      (a stall, a row, a count, or nothing), always with how old it is.
// boundary: reads one SK-ANSWER; draws text only. Picking the stall is followAnswer's job.
// ugly: before the first reply for a just-opened lot there is no answer yet; say "checking", not "none".
function renderAnswer(a, parent) {
    const box = h("div", "answer", undefined, parent);
    const main = h("div", "a-main", undefined, box);
    const sub = h("div", "a-sub", undefined, box);
    if (!liveOk) {
        box.classList.add("soft");
        main.textContent = "Can't reach live parking data";
        sub.textContent = "Nothing here can be called free right now.";
        return;
    }
    if (!a) {
        box.classList.add("soft");
        main.textContent = "Checking this lot…";
        return;
    }
    const age = formatAge(a.based_on ? a.based_on.age_s : null);
    if (a.grain === "stall") {
        main.textContent = "Best spot: " + spotName(a.stall_id);
        sub.textContent = "Seen free " + age + " by this lot's camera. Outlined in blue below.";
    } else if (a.grain === "zone") {
        box.classList.add("soft");
        main.textContent = "Row " + a.zone_id.split(":").pop() + ": about " + a.free_count + " free";
        sub.textContent = "As of " + age + ". This lot's sensor is too slow to promise one spot.";
    } else if (a.grain === "count") {
        box.classList.add("soft");
        main.textContent = "Last count: " + a.free_count + " / " + a.total_count + " free";
        sub.textContent = (a.based_on && a.based_on.fresh ? "Counted " : "Too old to trust: counted ") +
                          age + ". This lot only counts cars, it can't see single spots.";
    } else {
        box.classList.add("soft");
        const z = zones.find(function (q) { return q.id === a.lot_id; });
        const anyFree = z && lotStats(z).free > 0;
        // the pin can count a free ADA/EV stall that a regular car may not use; say so, don't contradict it
        main.textContent = anyFree && a.vehicle_class === "regular"
            ? "Free spots here are ADA or EV only" : "No free spot we can vouch for";
        sub.textContent = anyFree && a.vehicle_class === "regular"
            ? "Pick the ADA or EV tab if that's you. Otherwise try a nearby lot."
            : "Nothing seen free here recently. Spots in grey are unknown, not free.";
    }
}

function lotCard(item) {
    const z = item.z;
    const card = { z: z, spots: {} };

    const box = h("div", "lot-card" + (item.rank === 0 ? " best" : ""));
    card.box = box;

    const head = h("div", "lot-head", undefined, box);
    if (item.rank === 0) {
        h("span", "rank r0", "CLOSEST", head);
    } else if (item.rank === 1) {
        h("span", "rank r1", "2ND CLOSEST", head);
    }
    h("span", "lot-name", lotName(z), head);

    // the same verdict as this lot's pin, so the window and the map always agree
    const pinState = lotPinState(z);
    if (pinState) {
        const badge = h("span", "count-badge", pinState.label + " free", head);
        badge.style.background = PIN_HEX[pinState.cls];
    }

    const stats = lotStats(z);
    const line = h("div", "stat-line", undefined, box);
    [["free", "#1b8a3a", stats.free], ["taken", "#d62b2b", stats.taken],
     ["unknown", "#6b7280", stats.unknown]].forEach(function (s) {
        const item2 = h("span", "stat", undefined, line);
        const dot = h("span", "k", undefined, item2);
        dot.style.background = s[1];
        item2.appendChild(document.createTextNode(s[2] + " " + s[0]));
    });

    renderAnswer(answers[z.id], box);

    const dg = lotDiagram(z, box);
    card.svg = dg.svg;
    card.nodes = dg.nodes;
    card.routeG = dg.routeG;
    card.x0 = dg.x0;

    const a = answers[z.id];
    if (a && a.grain === "stall" && card.nodes[a.stall_id]) {
        card.nodes[a.stall_id].classList.add("best");
    }

    return card;
}

function renderWindow() {
    winTitle.textContent = win.title;
    winSub.textContent = win.sub;

    while (winBody.firstChild) {
        winBody.removeChild(winBody.firstChild);
    }
    cards.length = 0;

    win.lots.forEach(function (item) {
        const card = lotCard(item);
        cards.push(card);
        winBody.appendChild(card.box);
    });

    refreshSelection();
}

function refreshSelection() {
    if (!winOpen) {
        return;
    }
    cards.forEach(function (card) {
        Object.keys(card.nodes).forEach(function (id) {
            card.nodes[id].classList.toggle("selected", route !== null && route.id === id);
        });
        Object.keys(card.spots).forEach(function (id) {
            card.spots[id].classList.toggle("selected", route !== null && route.id === id);
        });
        drawLotRoute(card);
    });

    while (winFoot.firstChild) {
        winFoot.removeChild(winFoot.firstChild);
    }

    const info = h("div", "foot-info", undefined, winFoot);
    if (route === null) {
        h("div", "foot-main", "No spot picked yet", info);
        h("div", "foot-sub", "Pick a spot to see your route. It flashes blue as a preview.", info);
    } else {
        const st = stalls[route.id];
        h("div", "foot-main", spotName(route.id) + " · " + lotName(st.zone), info);
        h("div", "foot-sub", route.started
            ? "Route started (solid blue)."
            : (route.auto ? "Our pick for you, flashing blue. Pick another spot or press Start route."
                          : "Previewing (flashing blue). Press Start route to begin."), info);
    }

    const legend = h("div", "win-legend", undefined, winFoot);
    [["Free", "#1b8a3a"], ["Taken", "#d62b2b"], ["Unknown", "#6b7280"]].forEach(function (l) {
        const s = h("span", "stat", undefined, legend);
        const dot = h("span", "k", undefined, s);
        dot.style.background = l[1];
        s.appendChild(document.createTextNode(l[0]));
    });

    const cancel = h("button", "btn", "Cancel", winFoot);
    cancel.addEventListener("click", closeWindow);

    const start = h("button", "btn primary", "Start route", winFoot);
    start.disabled = (route === null || route.started);
    start.addEventListener("click", startRoute);
}

const side = document.getElementById("side");

function clearSide() {
    while (side.firstChild) {
        side.removeChild(side.firstChild);
    }
}

function add(tag, text, cls) {
    return h(tag, cls, text, side);
}

function showHelp() {
    if (route !== null && route.started) {
        showRoute();
        return;
    }
    clearSide();
    add("h2", "Stetson campus parking");

    if (winOpen) {
        add("div", "Pick a spot in the window. The route flashes blue on the map until " +
                   "you press Start route.", "sub");
        return;
    }

    add("div", "Click a P pin to open that lot, or a building to see the lots closest to it.", "sub");
    add("div", "Each pin's colour and count update every few seconds. Grey means our newest " +
               "data is too old to trust. You can also search for a lot or a spot " +
               "(like Sage, or Sage B-04) and press Enter.", "status-note");
}

function showRoute() {
    clearSide();
    const st = stalls[route.id];
    const pts = lotPath(st);

    add("h2", spotName(route.id));
    add("div", lotName(st.zone), "sub");

    const badges = add("div");
    const b1 = h("span", "badge" + (st.type === "ADA" ? " ada" : (st.type === "EV" ? " ev" : "")),
                 st.type, badges);
    h("span", "badge", "Route started", badges);

    add("div", totalMeters(pts) + " m from the lot entrance", "total");

    const ol = add("ol", undefined, "steps");
    stepsFor(st).forEach(function (text) {
        h("li", undefined, text, ol);
    });

    const age = stallInfo[route.id] ? formatAge(stallInfo[route.id].age_s) : "";
    add("div", "Live status: " + statusOf(route.id).replace("_", " ") + (age ? " (" + age + ")" : "") +
               ". This shows the way to the spot, it doesn't promise the spot is free.", "status-note");

    const show = add("button", "Show lot", "btn");
    show.addEventListener("click", openForRoute);

    const end = add("button", "End route", "btn");
    end.addEventListener("click", endRoute);
}

let filter = "All";
let query = "";

function countType(t) {
    let c = 0;
    Object.keys(stalls).forEach(function (id) {
        if (stalls[id].type === t) {
            c++;
        }
    });
    return c;
}

const chipNames = [
    { key: "All", text: "All spots" },
    { key: "Regular", text: "Regular (" + countType("Regular") + ")" },
    { key: "ADA", text: "ADA (" + countType("ADA") + ")" },
    { key: "EV", text: "EV Charging (" + countType("EV") + ")" }
];

const chipBox = document.getElementById("chips");

function drawChips() {
    while (chipBox.firstChild) {
        chipBox.removeChild(chipBox.firstChild);
    }
    chipNames.forEach(function (c) {
        const d = h("div", "chip" + (filter === c.key ? " on" : ""), c.text, chipBox);
        d.addEventListener("click", function () {
            filter = c.key;
            drawChips();
            updateLotPins();  // hide lots with none of this type, recount the rest
            if (winOpen) {
                if (route !== null && route.auto) {
                    route = null;  // the old pick was for another kind of car
                    drawMapRoute();
                }
                answers = {};
                renderWindow();
            }
            fetchStatus();    // guidance answers for the new car type right away
        });
    });
}

const searchBox = document.getElementById("search");

// "Sage B-04", "sage:b-04" and "SAGE  B-04" all mean the same spot
function normalSearch(text) {
    return text.trim().toUpperCase().replace(/[\\s:]+/g, " ");
}

searchBox.addEventListener("input", function () {
    query = normalSearch(searchBox.value);
    if (winOpen) {
        renderWindow();
    }
});

searchBox.addEventListener("keydown", function (ev) {
    if (ev.key === "Enter") {
        const wanted = normalSearch(searchBox.value);
        if (wanted === "") {
            return;
        }
        const hit = Object.keys(stalls).find(function (id) { return normalSearch(id) === wanted; });
        if (hit) {
            query = "";
            openForStall(hit);
            return;
        }
        // not a spot: the first lot whose name or id contains the text
        const lot = zones.find(function (z) {
            return normalSearch(lotName(z)).indexOf(wanted) >= 0 || normalSearch(z.id).indexOf(wanted) >= 0;
        });
        if (lot) {
            query = "";
            openForLot(lot);
        }
    }
});

drawChips();

function markBuilding(entry) {
    buildingNodes.forEach(function (b) {
        const on = (entry !== null && b === entry);
