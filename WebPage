<script>

const LAYOUT = __LAYOUT_JSON__;

const SVGNS = "http://www.w3.org/2000/svg";

// ---------- sizes ----------
// DK note: these numbers now come from measuring the real Stetson campus
// map image pixel-by-pixel (690 x 736), not a guessed 1024x787 layout.
// The commuter lot is anchored near the O-series commuter lots by Rinker
// Intramural Field, between East Oakdale Ave and East Pennsylvania Ave.
const S = 2;
// let, not const: the lot can need more room than the real photo is wide
// (see the note by BAND_LEFT below), so this grows after the lot is sized
let MAP_W = 690 * S;
let MAP_H = 736 * S;

const PX_PER_M = 4;
const STALL_W = 29;
const STALL_STEP = 31.5;
const STALL_H = 35;
const AISLE_H = 30;
const PAIR_GAP = 8;
const PAIR_H = STALL_H + AISLE_H + STALL_H;
const LANE_W = 38;
const LANE_PAD = 6;
const LOT_PAD = 10;
const ZONE_GAP = 10;
const LOT_HEAD = 28;

// the Main Gate is where N Woodland Blvd crosses E Michigan Ave (measured:
// Woodland Blvd x=168, Michigan Ave y=547, in picture units)
// ---------- the stretch ----------
// why: the middle of campus is crowded and the edges are roomy, so space is stretched where it is
//      needed: distance grows most around the dense centre and less toward the edges, while the map's
//      total size stays the same (so Fit still shows all of it).
// boundary: only how the picture is DRAWN. Every measurement (closest lot, routes' directions,
//           everything the server says) uses the real, unstretched positions.
// ugly: one stretch per axis, so roads stay straight and buildings stay upright; buildings keep
//       their size and only their spacing changes, never their order along a road.
const STRETCH = { x: { centre: 300, spread: 160, gain: 0.8, len: 690 },
                  y: { centre: 450, spread: 190, gain: 0.8, len: 736 } };

function stretchTable(o) {
    // density k(u) = base + gain·e^(−((u−centre)/spread)²), with base set so the total length is unchanged
    let bump = 0;
    for (let u = 0; u < o.len; u++) {
        bump += Math.exp(-Math.pow((u + 0.5 - o.centre) / o.spread, 2));
    }
    const base = 1 - o.gain * bump / o.len;
    const t = [0];
    for (let u = 0; u < o.len; u++) {
        t.push(t[u] + base + o.gain * Math.exp(-Math.pow((u + 0.5 - o.centre) / o.spread, 2)));
    }
    return t;
}
const TX = stretchTable(STRETCH.x);
const TY = stretchTable(STRETCH.y);

function along(t, u) {
    const i = Math.max(0, Math.min(t.length - 2, Math.floor(u)));
    return (t[i] + (t[i + 1] - t[i]) * (u - i)) * S;
}
// picture units -> drawn pixels
function WX(u) { return along(TX, u); }
function WY(v) { return along(TY, v); }

// a picture-unit rectangle, drawn: thin things (roads) keep their thickness; buildings keep their size
// unless the stretch squeezes them (then they shrink with it, so nothing overlaps at the edges)
function wRect(x, y, w, h, keepSize) {
    const fit = function (a, len, f) {
        const lo = f(a), hi = f(a + len);
        if (len <= 10 || keepSize) {
            const size = Math.min(len * S, hi - lo);
            const mid = f(a + len / 2);
            return [mid - size / 2, size];
        }
        return [lo, hi - lo];
    };
    const X = fit(x, w, WX), Y = fit(y, h, WY);
    return { x: X[0], y: Y[0], w: X[1], h: Y[1] };
}

// ---------- real-world coordinates ----------
// The drawing tied to the ground: five road crossings read off Google Maps by BD (2026-10-13),
// Woodland & Michigan, Woodland & Pennsylvania, Amelia & University, Garfield & Minnesota,
// Amelia & Ohio, fitted to the same crossings on this drawing. Every point fits within about 1 m
// (each predicted from the other four within 4 m); the drawing is north-up to 0.2 degrees.
// metres east and north of (GEO.lat0, GEO.lon0) = u * A[0] + v * A[1] + A[2], u/v in picture units
const GEO = { lat0: 29.0355, lon0: -81.2995,
              A: [[1.80372, 0.00531], [0.05338, -1.81864], [-730.5595, 774.4908]] };
const M_PER_UNIT = 1.81;   // one picture unit is about 1.81 m on the ground

function geoToPic(lat, lon) {
    const mx = (lon - GEO.lon0) * Math.cos(GEO.lat0 * Math.PI / 180) * 111320 - GEO.A[2][0];
    const my = (lat - GEO.lat0) * 110574 - GEO.A[2][1];
    const a = GEO.A[0][0], b = GEO.A[1][0], c = GEO.A[0][1], d = GEO.A[1][1];
    const det = a * d - b * c;
    return { u: (d * mx - b * my) / det, v: (-c * mx + a * my) / det };
}

// straight-line metres between two points in picture units (the real, unstretched positions)
function unitsToMetres(u1, v1, u2, v2) {
    return Math.round(Math.hypot(u2 - u1, v2 - v1) * M_PER_UNIT);
}

const GATE_U = 169, GATE_V = 547;    // the Main Gate: where Woodland's and Michigan's centrelines cross
let me = null;   // the driver from the browser's location: {u, v, acc (m), onCampus}, or null
const GATE_X = WX(GATE_U);
const GATE_Y = WY(GATE_V);

// the lot's own road is East Oakdale Ave (measured y=98), the road the
// O-series commuter lots open onto, north of the Rinker Intramural block
const LOT_ROAD_Y = 98 * S;
const ROAD_HALF = 5 * S;
const LOT_TOP = LOT_ROAD_Y + ROAD_HALF + 40;
// DK note: the real block by Oakdale Ave is only ~250 map units wide, but a
// 120-stall lot drawn at a readable size needs much more room than that (the
// stall sizes above are tuned for clickability, not to the real block's
// footprint). The lot itself is never drawn on the main map - only its gate
// marker and entrance point are - so the lot starts just past the gate's
// road and the canvas grows to fit it (see "MAP_W = Math.max(...)" below),
// instead of trying to squeeze it into the real block's actual width.
const BAND_LEFT = GATE_X + 20;

function el(tag, attrs, parent, text) {
    const e = document.createElementNS(SVGNS, tag);
    for (const k in attrs) {
        e.setAttribute(k, attrs[k]);
    }
    if (text !== undefined) {
        e.textContent = text;
    }
    if (parent) {
        parent.appendChild(e);
    }
    return e;
}

function cap(s) {
    return s.charAt(0).toUpperCase() + s.slice(1);
}

// a lot's display name from campus.json ("Sage Hall Lot"), falling back to its id
function lotName(z) {
    return z.name || (cap(z.id) + " lot");
}

function dist(a, b) {
    return Math.hypot(b[0] - a[0], b[1] - a[1]);
}

const stalls = {};
const zones = [];

function lotWidth(zone) {
    let perRow = 0;
    zone.rows.forEach(function (r) {
        perRow = Math.max(perRow, r.stalls.length);
    });
    return LANE_W + LANE_PAD + perRow * STALL_STEP - (STALL_STEP - STALL_W);
}

let rowWidth = 0;
let lotCount = 0;
LAYOUT.zones.forEach(function (zone) {
    if (zone.rows.length > 0) {
        rowWidth += lotWidth(zone) + 2 * LOT_PAD + (lotCount > 0 ? ZONE_GAP : 0);
        lotCount++;
    }
});

// grow the canvas to fit the lot if it needs more room than the real photo
// is wide, instead of risking the entrance marker landing off the edge
// Campus (nine lots): the lot grids are a working space for the pop-up only and are never
// drawn on the campus picture, so the canvas no longer grows to fit all nine side by side.

let cursorX = BAND_LEFT + LOT_PAD;

LAYOUT.zones.forEach(function (zone) {

    if (zone.rows.length === 0) {
        return;
    }

    let perRow = 0;
    zone.rows.forEach(function (r) {
        perRow = Math.max(perRow, r.stalls.length);
    });

    const pairs = Math.ceil(zone.rows.length / 2);
    const height = pairs * PAIR_H + (pairs - 1) * PAIR_GAP;
    const width = LANE_W + LANE_PAD + perRow * STALL_STEP - (STALL_STEP - STALL_W);

    const z = {
        id: zone.id,
        name: zone.name,
        rows: zone.rows,
        x: cursorX,
        y: LOT_TOP + LOT_PAD + LOT_HEAD,
        w: width,
        h: height,
        laneX: cursorX + LANE_W / 2,
        pairs: pairs,
        aisles: []
    };

    for (let p = 0; p < pairs; p++) {
        const pairTop = z.y + p * (PAIR_H + PAIR_GAP);
        z.aisles.push({
            y: pairTop + STALL_H + AISLE_H / 2,
            rowA: zone.rows[2 * p].id,
            rowB: zone.rows[2 * p + 1] ? zone.rows[2 * p + 1].id : null
        });
    }

    zone.rows.forEach(function (row, ri) {
        const pair = Math.floor(ri / 2);
        const second = (ri % 2 === 1);
        const pairTop = z.y + pair * (PAIR_H + PAIR_GAP);

        row.stalls.forEach(function (s, si) {
            stalls[s.id] = {
                id: s.id,
                n: s.n,
                type: s.t,
                zone: z,
                row: row.id,
                pair: pair,
                x: cursorX + LANE_W + LANE_PAD + si * STALL_STEP,
                y: pairTop + (second ? STALL_H + AISLE_H : 0),
                aisleY: z.aisles[pair].y
            };
        });
    });

    zones.push(z);
    // Campus: every lot's grid starts at the same spot. Each is only ever shown alone in the
    // pop-up, so side by side they only made far-right lots look hundreds of metres away.
});

