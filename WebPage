let pan = null;

svg.addEventListener("pointerdown", function (ev) {
    if (ev.button !== undefined && ev.button !== 0) {
        return;
    }
    if (ev.target.closest && ev.target.closest(".building, .pin")) {
        return;
    }
    pan = { x: ev.clientX, y: ev.clientY, left: scroller.scrollLeft,
            top: scroller.scrollTop, moved: false, id: ev.pointerId };
});

svg.addEventListener("pointermove", function (ev) {
    if (pan === null) {
        return;
    }
    const dx = ev.clientX - pan.x;
    const dy = ev.clientY - pan.y;
    if (!pan.moved && Math.hypot(dx, dy) < 6) {
        return;
    }
    if (!pan.moved) {
        pan.moved = true;
        svg.setPointerCapture(pan.id);
    }
    scroller.scrollLeft = pan.left - dx;
    scroller.scrollTop = pan.top - dy;
});

function endPan() {
    pan = null;
}
svg.addEventListener("pointerup", endPan);
svg.addEventListener("pointercancel", endPan);

