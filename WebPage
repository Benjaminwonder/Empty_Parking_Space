    return t === "Regular" || (t === "ADA" && vehicleClass() === "ada") || (t === "EV" && vehicleClass() === "ev");
}

// a spot can be claimed only while a stall sensor sees it free and it suits the car (the server decides)
function claimable(id) {
    const info = stallInfo[id];
    return !!info && info.state === "free" && !info.held && !countedLot(stalls[id].zone) && typeAllowed(id);
}

// why: the one button that turns "our pick" into "yours": first press wins the spot on the server.
// boundary: POST /claim; on success starts the route; on refusal explains and lets guidance pick again.
// ugly: someone else may claim it a second earlier; we say so and move on, we never retry the same spot.
function claimSpot(id) {
    fetch(SK_VIEW_URL.replace("/view", "/claim") + "?stall_id=" + encodeURIComponent(id) +
          "&driver_id=" + encodeURIComponent(DRIVER_ID) + "&vehicle_class=" + vehicleClass(), { method: "POST" })
        .then(function (r) {
            return r.json().then(function (body) { return { ok: r.ok, body: body }; });
        })
        .then(function (res) {
            if (res.ok) {
                myClaim = res.body.my_claim;
                route = { id: id, started: false, auto: false };
                startRoute();
            } else {
                showToast("Couldn't claim that spot", res.body.message || "Try another spot.");
                if (route !== null && route.id === id) {
                    route = null;
                    drawMapRoute();
                }
            }
            fetchStatus();
        })
        .catch(function () {
            showToast("Couldn't reach ParkFind", "Your spot was not claimed. Check the connection and try again.");
        });
}

// why: letting go of a spot ends the trip to it: the route, the close-up and the side panel all clear.
// boundary: POST /release for this driver only; the map is cleared at once, the server catches up.
// ugly: if the release request fails, the claim still times out on the server by its own rules.
function releaseSpot() {
    myClaim = null;
    if (winOpen) {
        closeWindow();
    }
    endRoute();
    fetch(SK_VIEW_URL.replace("/view", "/release") + "?driver_id=" + encodeURIComponent(DRIVER_ID),
          { method: "POST" })
        .then(function () {
            fetchStatus();
        });
}

// why: when guidance names a stall in the open window, preselect it, so the driver sees the best
//      spot without hunting; it follows the answer on every poll until the driver picks their own.
// boundary: only moves a route the page chose itself (route.auto); a driver's pick is never overridden.
// ugly: a started route is never moved, even if its stall is taken meanwhile; claims (next slice) handle that.
function followAnswer() {
    if (!winOpen || !win || (route !== null && !route.auto)) {
        return;
    }
    if (myClaim !== null && win.lots.some(function (item) { return stalls[myClaim.stall_id].zone === item.z; })) {
        if (route === null || route.id !== myClaim.stall_id) {
            route = { id: myClaim.stall_id, started: false, auto: true };  // your held spot comes first
            drawMapRoute();
        }
        return;
    }
    let pick = null;
