// one id per browser tab, sent as driver_id. this Math.random is a session
// token, not a stand-in for occupancy - the "no fake occupancy" rule is
// about spot status, which never comes from Random anywhere in this file.
const DRIVER_ID = "web-" + Math.random().toString(36).slice(2, 10);

const SK_VIEW_URL = "http://localhost:8765/view";

let liveOk = false;    // did the last fetch succeed?
let lastAsOf = null;   // as_of from the last good response
