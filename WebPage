        const len = Math.hypot(b.u - a.u, b.v - a.v) * M_PER_UNIT;
        const dir = [Math.sign(Math.round(b.u - a.u)), Math.sign(Math.round(b.v - a.v))];
        if (legs.length && legs[legs.length - 1].key === key) {
            legs[legs.length - 1].len += len;
        } else {
            legs.push({ key: key, len: len, dir: dir });
        }
    }
    let lead = 0;
    while (legs.length > 1 && legs[0].len < 10) {
        lead += legs.shift().len;
    }
    const m = Math.max(10, Math.round((lead + legs[0].len) / 10) * 10);
    if (legs.length === 1) {
        return { icon: "P", text: "Drive into " + lotName(z), m: m };
    }
    const now = legs[0], next = legs[1];
    const straight = now.dir[0] === next.dir[0] && now.dir[1] === next.dir[1];
    const word = straight ? "straight" : turnWord(now.dir, next.dir);
    const icon = word === "left" ? "↰" : word === "right" ? "↱" : "↑";
    if (now.key === "join") {
        return { icon: "↑", text: "Join " + roadName(ROAD_LINES[next.key === "lot" ? 0 : next.key]), m: m };
    }
    if (next.key === "lot") {
        return { icon: icon, text: (straight ? "Continue" : "Turn " + word) + " into " + lotName(z), m: m };
    }
    return { icon: icon, text: (straight ? "Continue" : "Turn " + word) + " onto " + roadName(ROAD_LINES[next.key]), m: m };
}

// three widths across the close-up (about 160 / 290 / 510 m); street level first: the view a driver needs
const CU_ZOOMS = [{ half: 45, bar: 20 }, { half: 80, bar: 50 }, { half: 140, bar: 100 }];
let cuZoom = 0;
try {
    cuZoom = Math.min(2, Math.max(0, parseInt(window.localStorage.getItem("parkfind.cuZoom") || "0", 10) || 0));
} catch (e) {
    cuZoom = 0;
}
let closeAngle = 0;        // degrees the close-up is turned clockwise; 0 = north up
let headingMode = false;   // the phone's compass turns the map, so what is ahead is up

// where a ground point lands on the turned close-up (labels are drawn upright there, outside the turned group)
function turned(u, v, o) {
    const r = closeAngle * Math.PI / 180, du = u - o.u, dv = v - o.v;
    return { x: o.u + du * Math.cos(r) - dv * Math.sin(r), y: o.v + du * Math.sin(r) + dv * Math.cos(r) };
}

function upright(text, x, y, attrs, svg, size) {
    return el("text", Object.assign({ x: x, y: y, "font-size": size, fill: "#202124", stroke: "#ffffff",
                                      "stroke-width": size * 0.3, "paint-order": "stroke" }, attrs || {}), svg, text);
}

// why: something worth finding that is off the edge still gets a mark: an arrow on the edge pointing at it.
// boundary: draws upright marks into the close-up svg; s is the thing's turned position.
// ugly: the edge is inset so arrows clear the scale bar and credit, the buttons on the right and the next-turn
//       banner; when two labels would overlap, the later one steps down until it is clear.
function edgeMark(s, o, view, label, colour, svg) {
    const inside = s.x > view.x0 + view.pad && s.x < view.x0 + view.W - view.padR &&
                   s.y > view.y0 + view.padT && s.y < view.y0 + view.H - view.padB;
    if (inside) {
        return false;
    }
    const dx = s.x - o.u, dy = s.y - o.v;
    const k = Math.min(Math.max(1e-6, dx > 0 ? view.x0 + view.W - view.padR - o.u : o.u - view.x0 - view.pad) / Math.max(1e-6, Math.abs(dx)),
                       Math.max(1e-6, dy > 0 ? view.y0 + view.H - view.padB - o.v : o.v - view.y0 - view.padT) / Math.max(1e-6, Math.abs(dy)));
    const ex = o.u + dx * k, ey = o.v + dy * k, ang = Math.atan2(dy, dx);
    const a = view.u;   // one screen pixel in picture units at this zoom
    // labels never sit on each other: estimate this label's box and step it down until it is clear
    const anchor = Math.cos(ang) > 0.3 ? "end" : Math.cos(ang) < -0.3 ? "start" : "middle";
    const lw = label.length * 6.2 * a, lx = ex - Math.cos(ang) * 11 * a;
    const left = anchor === "end" ? lx - lw : anchor === "start" ? lx : lx - lw / 2;
    let ly = ey - Math.sin(ang) * 11 * a + 3.5 * a;
    const hits = function (y) {
        return view.marks.some(function (m) {
            return left < m.x + m.w && left + lw > m.x && y - 14 * a < m.y && y > m.y - 14 * a;
        });
    };
    for (let tries = 0; tries < 4 && hits(ly); tries++) {
        ly += 14 * a;
    }
    view.marks.push({ x: left, y: ly, w: lw });
    el("path", { d: "M" + 9 * a + ",0 L" + (-5 * a) + "," + (-7 * a) + " L" + (-5 * a) + "," + 7 * a + " Z", fill: colour,
                 stroke: "#ffffff", "stroke-width": 1.5 * a,
                 transform: "translate(" + ex + " " + ey + ") rotate(" + ang * 180 / Math.PI + ")" }, svg);
    upright(label, lx, ly, { "text-anchor": anchor, "font-weight": "bold", fill: colour }, svg, 10 * a);
    return true;
}

// why: one close-up for every start point: you (live location) or the Main Gate, with or without a route.
// boundary: draws into #closeup only; the route is tripTo() (the same Dijkstra route as the big map).
// ugly: the map turns, the words do not: every label is placed at its turned spot and drawn upright. You sit
//       below the middle, so more of the road ahead (the top) is in view.
function drawCloseup() {
    const box = document.getElementById("closeup");
    const svg = document.getElementById("closeupSvg");
    while (svg.firstChild) {
        svg.removeChild(svg.firstChild);
    }
    const o = origin();
    if (route === null && o.atGate) {
        box.classList.remove("show");
        return;
    }
    box.classList.add("show");
    const z = route !== null ? stalls[route.id].zone : null;
    document.getElementById("closeupTitle").textContent = (o.atGate ? "Starting at the Main Gate" : "You are here") +
                                                         (z !== null ? " → " + lotName(z) : "");
    const routeAge = route !== null && stallInfo[route.id] ? formatAge(stallInfo[route.id].age_s) : "";
    document.getElementById("closeupAge").textContent = routeAge ? "Your spot's last update: " + routeAge
        : (o.atGate ? "" : "Location accurate to about " + Math.round(me.acc) + " m");

    const lm = nearestLandmark(o.u, o.v);
    const lmLine = document.getElementById("closeupLandmark");
    lmLine.textContent = "";
    if (lm !== null) {
        lmLine.appendChild(document.createTextNode("Nearest landmark: "));
        h("b", undefined, buildingName(lm.b.n), lmLine);
        lmLine.appendChild(document.createTextNode(", " + Math.max(10, Math.round(lm.d * M_PER_UNIT / 10) * 10) +
                                                   " m " + compassWord(lm.u - o.u, lm.v - o.v)));
    }

    // the next turn, in words, over the top of the map
    const nextEl = document.getElementById("cuNext");
    const nm = z !== null ? nextManeuver(z) : null;
    nextEl.hidden = nm === null;
    if (nm !== null) {
        nextEl.textContent = "";
        h("span", "cu-next-icon", nm.icon, nextEl);
        const t = h("span", "cu-next-text", undefined, nextEl);
        h("b", undefined, nm.m + " m", t);
        t.appendChild(document.createTextNode(" · " + nm.text));
    }

    const zoom = CU_ZOOMS[cuZoom];
    const rect = svg.getBoundingClientRect();
    const W = 2 * zoom.half, H = W * ((rect.height || 220) / (rect.width || 320));
    const u = W / (rect.width || 320);   // one screen pixel, in picture units
    const view = { x0: o.u - W / 2, y0: o.v - H * 0.62, W: W, H: H, u: u, pad: 14 * u, padR: 40 * u,
                   padT: (nm !== null ? 50 : 14) * u, padB: 34 * u, marks: [] };
    svg.setAttribute("viewBox", view.x0 + " " + view.y0 + " " + W + " " + H);
    el("rect", { x: view.x0 - W, y: view.y0 - H, width: 3 * W, height: 3 * H, fill: "#e8efe0" }, svg);

    const g = el("g", { transform: "rotate(" + closeAngle + " " + o.u + " " + o.v + ")" }, svg);
    // our own roads and buildings first: they are what shows if the tiles cannot load
    ROAD_LINES.forEach(function (r) {
        el("rect", r.v ? { x: r.c - r.w / 2, y: r.a, width: r.w, height: r.b - r.a, fill: "#c4c7cb" }
                       : { x: r.a, y: r.c - r.w / 2, width: r.b - r.a, height: r.w, fill: "#c4c7cb" }, g);
    });
    BUILDINGS.forEach(function (b) {
        b.parts.forEach(function (p) {
            el("rect", { x: p[0], y: p[1], width: p[2], height: p[3], rx: 2, fill: "#ddd2c2", stroke: "#a99a86",
                         "stroke-width": u }, g);
        });
    });
    g.appendChild(osmLayer());
    if (lm !== null) {
        lm.b.parts.forEach(function (p) {
            el("rect", { x: p[0], y: p[1], width: p[2], height: p[3], rx: 2, fill: "#b45309", "fill-opacity": 0.12,
                         stroke: "#b45309", "stroke-width": 2.5 * u }, g);
        });
    }
    let dest = null;
    if (z !== null) {
        const trip = tripTo(z);
        if (trip !== null) {
            dest = trip[trip.length - 1];
            const d = roundedPath(trip.map(function (p) { return [p.u, p.v]; }), 6 * u);
            el("path", { d: d, fill: "none", stroke: "#ffffff", "stroke-width": 9 * u, "stroke-linecap": "round",
                         "stroke-linejoin": "round" }, g);
            el("path", { d: d, fill: "none", stroke: "#1a73e8", "stroke-width": 5 * u, "stroke-linecap": "round",
                         "stroke-linejoin": "round", "class": route.started ? "" : "route-flow" }, g);
        }
    }
    if (o.atGate) {
        el("circle", { cx: o.u, cy: o.v, r: 7 * u, fill: "#ffffff", stroke: "#14532d", "stroke-width": 4 * u }, g);
    } else {
        el("circle", { cx: o.u, cy: o.v, r: Math.max(10 * u, me.acc / M_PER_UNIT), fill: "#1a73e8", opacity: 0.15 }, g);
        if (headingMode) {
            // facing: the map is turned so what is ahead is up, so the beam points up on screen
            el("path", { d: "M" + o.u + "," + o.v + " L" + (o.u - 9 * u) + "," + (o.v - 26 * u) + " A" + 27 * u + "," +
                         27 * u + " 0 0 1 " + (o.u + 9 * u) + "," + (o.v - 26 * u) + " Z", fill: "#1a73e8", opacity: 0.3 }, svg);
        }
        el("circle", { cx: o.u, cy: o.v, r: 7 * u, fill: "#1a73e8", stroke: "#ffffff", "stroke-width": 3 * u }, g);
    }

    // upright marks: the lot (pin, or an arrow on the edge) and the landmark's name
    if (dest !== null) {
        const s = turned(dest.u, dest.v, o);
        const far = Math.max(10, Math.round(Math.hypot(dest.u - o.u, dest.v - o.v) * M_PER_UNIT / 10) * 10);
        if (!edgeMark(s, o, view, "P · " + far + " m", "#1b8a3a", svg)) {
            el("path", { d: "M0,0 C" + (-6 * u) + "," + (-9 * u) + " " + (-9 * u) + "," + (-13 * u) + " " + (-9 * u) + "," +
                         (-18 * u) + " A" + 9 * u + "," + 9 * u + " 0 1 1 " + 9 * u + "," + (-18 * u) + " C" + 9 * u + "," +
                         (-13 * u) + " " + 6 * u + "," + (-9 * u) + " 0,0 Z", fill: "#1b8a3a", stroke: "#ffffff",
                         "stroke-width": 1.5 * u, transform: "translate(" + s.x + " " + s.y + ")" }, svg);
            el("text", { x: s.x, y: s.y - 14 * u, "font-size": 11 * u, "font-weight": "bold", fill: "#ffffff",
                         "text-anchor": "middle" }, svg, "P");
        }
    }
    if (lm !== null) {
        const s = turned(lm.u, lm.v, o), name = buildingShort(lm.b.n);
        if (!edgeMark(s, o, view, name, "#b45309", svg)) {
            upright(name, s.x, s.y + 3.5 * u, { "text-anchor": "middle", "font-weight": "bold", fill: "#b45309" }, svg, 10 * u);
        }
    }
    // scale bar, bottom right (left of nothing: the buttons stop above it), and the map credit, bottom left
    const bx = view.x0 + W - 8 * u, by = view.y0 + H - 8 * u, bl = zoom.bar / M_PER_UNIT;
    el("path", { d: "M" + (bx - bl) + "," + (by - 4 * u) + " L" + (bx - bl) + "," + by + " L" + bx + "," + by + " L" + bx +
                 "," + (by - 4 * u), fill: "none", stroke: "#3c4043", "stroke-width": 1.5 * u }, svg);
    upright(zoom.bar + " m", bx - bl / 2, by - 6 * u, { "text-anchor": "middle", fill: "#3c4043" }, svg, 9 * u);
    upright("© OpenStreetMap contributors", view.x0 + 4 * u, view.y0 + H - 5 * u, { fill: "#3c4043" }, svg, 8 * u);
    document.getElementById("cuNeedle").setAttribute("transform", "rotate(" + closeAngle + ")");
    document.getElementById("cuIn").disabled = cuZoom === 0;
    document.getElementById("cuOut").disabled = cuZoom === CU_ZOOMS.length - 1;
}

// why: turn and zoom the close-up by hand, or let the phone's compass keep what is ahead at the top.
// boundary: changes closeAngle / cuZoom and redraws the close-up; touches nothing else on the page.
// ugly: compass events arrive dozens of times a second; redraws are capped at five a second. iPhones ask
//       permission first (on a tap), and a phone held sideways adds its screen angle.
function turnCloseup(deg) {
    headingMode = false;
    document.getElementById("cuHeading").classList.remove("on");
    closeAngle = deg === null ? 0 : ((closeAngle + deg) % 360 + 360) % 360;
    drawCloseup();
}

function zoomCloseup(step) {
    cuZoom = Math.min(CU_ZOOMS.length - 1, Math.max(0, cuZoom + step));
    try {
        window.localStorage.setItem("parkfind.cuZoom", String(cuZoom));
    } catch (e) {
        // the zoom simply isn't remembered
    }
    drawCloseup();
}

document.getElementById("cuNorth").addEventListener("click", function () { turnCloseup(null); });
document.getElementById("cuLeft").addEventListener("click", function () { turnCloseup(-30); });
document.getElementById("cuRight").addEventListener("click", function () { turnCloseup(30); });
document.getElementById("cuIn").addEventListener("click", function () { zoomCloseup(-1); });
document.getElementById("cuOut").addEventListener("click", function () { zoomCloseup(1); });

let headingDrawn = 0;
function onHeading(e) {
    let heading = null;
    if (typeof e.webkitCompassHeading === "number") {
        heading = e.webkitCompassHeading;           // iPhone: already degrees from north
    } else if (e.absolute && typeof e.alpha === "number") {
        heading = 360 - e.alpha;                     // Android: alpha counts the other way
    }
    if (!headingMode || heading === null || Date.now() - headingDrawn < 200) {
        return;
    }
    headingDrawn = Date.now();
    const screenTurn = (screen.orientation && screen.orientation.angle) || 0;
    closeAngle = ((-(heading + screenTurn)) % 360 + 360) % 360;
    drawCloseup();
}

(function () {
    const btn = document.getElementById("cuHeading");
    const touch = window.matchMedia && window.matchMedia("(pointer: coarse)").matches;
    if (!touch || !("DeviceOrientationEvent" in window)) {
        return;   // a laptop has no compass: the button stays hidden
    }
    btn.hidden = false;
    btn.addEventListener("click", function () {
        if (headingMode) {
            turnCloseup(null);
            return;
        }
        const start = function () {
            headingMode = true;
            btn.classList.add("on");
            window.addEventListener("ondeviceorientationabsolute" in window ? "deviceorientationabsolute"
                                    : "deviceorientation", onHeading);
        };
        if (typeof DeviceOrientationEvent.requestPermission === "function") {
            DeviceOrientationEvent.requestPermission().then(function (r) { if (r === "granted") { start(); } });
        } else {
            start();
        }
    });
})();

function selectSpot(id) {
    route = { id: id, started: false, auto: false };
    drawMapRoute();
    refreshSelection();
    showHelp();
}

function startRoute() {
    if (route === null) {
        return;
    }
    route.started = true;
    drawMapRoute();
    closeWindow();
    showRoute();
}

function endRoute() {
    route = null;
    drawMapRoute();
    markBuilding(null);
    selectedBuilding = null;
