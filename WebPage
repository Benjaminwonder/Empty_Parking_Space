const cards = [];

function passes(id) {
    const st = stalls[id];
    if (filter !== "All" && st.type !== filter) {
        return false;
    }
    if (query !== "" && normalSearch(id).indexOf(query) < 0 &&
        normalSearch(lotName(st.zone)).indexOf(query) < 0) {
        return false;
    }
    return true;
}

// why: some sensors count cars (per row, or at the gate) and never see a single stall; those lots
//      must be drawn as "counted", or a true "9/22 free" pin sits over 22 grey stalls and reads as a lie.
// boundary: decides from the data on hand: most stalls unknown and a count exists.
// ugly: counted stalls are still not free; they get their own neutral look, never green.
function countedLot(z) {
    const t = lotStats(z);
    return t.total > 0 && t.unknown > t.total / 2 && zoneInfo[z.id] !== undefined;
}

function lotDiagram(z, parent) {
