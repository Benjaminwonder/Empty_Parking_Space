	public static void main(String[] args) throws Exception {

		System.out.println("starting server...");

		HttpServer myServer = HttpServer.create(new InetSocketAddress(myPort), 0);

		// i used a regular class here instead of the arrow thing (lambda)
		// because it made more sense to me to write it this way
		myServer.createContext("/", new MyHandler());

		myServer.start();

		System.out.println("Practice lot running at http://localhost:" + myPort);
	}

	// this class is what actually sends the webpage back when someone
	// opens the link in their browser
	static class MyHandler implements HttpHandler {
		public void handle(HttpExchange exchange) throws IOException {

			byte[] pageBytes = PAGE.getBytes(StandardCharsets.UTF_8);

			exchange.getResponseHeaders().set("Content-Type", "text/html; charset=utf-8");
			exchange.sendResponseHeaders(200, pageBytes.length);

			exchange.getResponseBody().write(pageBytes);
			exchange.getResponseBody().close();
		}
	}
