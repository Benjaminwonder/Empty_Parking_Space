let appliedSeq = 0;

function viewUrl(lotId) {
    return SK_VIEW_URL + "?vehicle_class=" + vehicleClass() + "&driver_id=" +
           encodeURIComponent(DRIVER_ID) + (lotId ? "&lot_id=" + encodeURIComponent(lotId) : "");
}

// why: one poll refreshes everything on screen from one moment of data, so pins, window,
//      close-up and route panel never disagree with each other.
// boundary: reads SK-VIEW only (status for everything, answer per open lot); writes page state.
// ugly: replies can land out of order (a slow request after a fast newer one); the older
//       reply is dropped, never painted over newer data.
function fetchStatus() {
    const seq = ++pollSeq;
    const lotIds = (winOpen && win) ? win.lots.map(function (item) { return item.z.id; }) : [];
    const asks = lotIds.length > 0 ? lotIds : [null];
    Promise.all(asks.map(function (lotId) {
        return fetch(viewUrl(lotId)).then(function (r) {
            if (!r.ok) {
                throw new Error("bad status " + r.status);
            }
            return r.json();
        });
    }))
        .then(function (views) {
            if (seq < appliedSeq) {
                return;
            }
            appliedSeq = seq;
            const data = views[0];
            stallInfo = data.status.stalls || {};
            // each pin's fallback count: status.lots[lot].last_count (hourly zone counts or a
            // gate count), so a lot whose stalls are all unknown still shows "~N/M" and its age
            zoneInfo = {};
            const lots = data.status.lots || {};
            Object.keys(lots).forEach(function (lotId) {
                if (lots[lotId].last_count) {
                    zoneInfo[lotId] = lots[lotId].last_count;
                }
            });
            answers = {};
            views.forEach(function (v, i) {
                if (asks[i] && v.answer) {
                    answers[asks[i]] = v.answer;
                }
            });
            const map = {};
            Object.keys(stallInfo).forEach(function (id) {
                map[id] = stallInfo[id].state;
            });
            lastAsOf = data.as_of;
            liveOk = true;
            renderTopBar();
            followAnswer();
            setStatus(map);
            updateLotPins();
        })
        .catch(function () {
            if (seq < appliedSeq) {
                return;
            }
            liveOk = false;
            renderTopBar();
        });
}

