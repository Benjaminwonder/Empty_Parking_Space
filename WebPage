const searchBox = document.getElementById("search");

// "Sage B-04", "sage:b-04" and "SAGE  B-04" all mean the same spot
function normalSearch(text) {
    return text.trim().toUpperCase().replace(/[\\s:]+/g, " ");
}

searchBox.addEventListener("input", function () {
    query = normalSearch(searchBox.value);
    if (winOpen) {
        renderWindow();
    }
});

searchBox.addEventListener("keydown", function (ev) {
    if (ev.key === "Enter") {
        const wanted = normalSearch(searchBox.value);
        if (wanted === "") {
            return;
        }
        const hit = Object.keys(stalls).find(function (id) { return normalSearch(id) === wanted; });
        if (hit) {
            query = "";
            openForStall(hit);
            return;
        }
        // a lot whose name or id starts with the text wins first: "Sage" is the lot, "east" is East Lot
        // "Lot 41" / "lot 08" names the official lot; a bare number stays a building number (the map's own pins)
        const lotNumber = /^LOT 0?(\\d+)$/.exec(wanted);
        const lotFirst = zones.find(function (z) {
            if (lotNumber) {
                return / LOT 0?(\\d+)$/.test(normalSearch(lotName(z))) &&
                       normalSearch(lotName(z)).replace(/^.* LOT 0?/, "") === lotNumber[1];
            }
            return normalSearch(lotName(z)).indexOf(wanted) === 0 || normalSearch(z.id) === wanted;
        });
        if (lotFirst) {
            query = "";
            openForLot(lotFirst);
            return;
        }
        // then a building by number ("54"), short name ("CUB") or full name ("Flagler"): its closest lots
        const bld = buildingNodes.find(function (e) {
            return String(e.n) === wanted || normalSearch(e.short) === wanted;
        }) || buildingNodes.find(function (e) {
            return normalSearch(e.name).indexOf(wanted) >= 0;
        });
        if (bld) {
            query = "";
            openForBuilding(bld);
            return;
        }
        // not a spot: the first lot whose name or id contains the text
        const lot = zones.find(function (z) {
            return normalSearch(lotName(z)).indexOf(wanted) >= 0 || normalSearch(z.id).indexOf(wanted) >= 0;
        });
        if (lot) {
            query = "";
            openForLot(lot);
        }
    }
});

