// why: the driver gets the nearest lot where a spot can be promised (a live camera sees it free), and
//      is told about a closer lot that seems to have room but only through a slow sensor, without
//      being steered to that gamble.
// boundary: reads the same status as the pins; distances from the real (unstretched) positions.
// ugly: if no lot has a guaranteed spot, the nearest lot with room leads, clearly marked as not guaranteed.
function lotSuggestions() {
    let sure = null, room = null, any = null;
    zones.forEach(function (z) {
        const d = metresToLot(z), st = lotPinState(z);
        if (d === null || st === null) {
