function lotStats(z) {
    const ids = tabIds(z);
    const t = { free: 0, taken: 0, unknown: 0, total: ids.length };
    ids.forEach(function (id) {
        const s = statusOf(id);
        if (s === "free") {
            t.free++;
        } else if (isTaken(s)) {
            t.taken++;
        } else {
            t.unknown++;
        }
    });
    return t;
}

// share of a lot that must be free for a green pin; above zero but below it is amber
const PLENTY_SHARE = 0.25;

// why: one verdict per lot (colour + "13/32") that the pin, the window badge and the legend all
//      read, so the map and the pop-up can never show two different numbers for one lot.
// boundary: reads STATUS (aged stall states) and zoneInfo (the lot's last count); the tab narrows it.
// ugly: unknown is never counted as free. When most stalls are unknown we fall back to the lot's
//       count, and an expired count is grey with "~": it is what we last knew, not what is there.
function lotPinState(z) {
    const t = lotStats(z);
    if (t.total === 0) {
        return null;  // no stall of this tab's type here: the pin hides
    }
    const verdict = function (free, total, fresh) {
        let cls = "p-unsure";
        if (fresh) {
            cls = free === 0 ? "p-full" : (free / total >= PLENTY_SHARE ? "p-plenty" : "p-filling");
        }
        return { cls: cls, label: (fresh ? "" : "~") + free + "/" + total, free: free, total: total };
    };
    if (t.unknown <= t.total / 2) {
        // stall sensors see most of the lot; any unknown stall is counted as not free
        return verdict(t.free, t.total, true);
    }
    const count = zoneInfo[z.id];
    if (count && (filter === "All" || filter === "Regular")) {
        let free = count.free_count;
        let total = count.total_count;
        if (filter === "Regular") {
            // a lot count includes ADA/EV stalls; for a regular car it is a lower bound (D4)
            free = Math.max(0, free - (z.ids.length - t.total));
            total = t.total;
        }
        return verdict(free, total, count.state === "fresh");
    }
    if (t.free === 0) {
        // nothing known at all (before a lot's first count): "?" not "~0", which would read as full
        return { cls: "p-unsure", label: "?/" + t.total, free: 0, total: t.total };
    }
    return verdict(t.free, t.total, false);
}

const PIN_HEX = { "p-plenty": "#1b8a3a", "p-filling": "#d97706", "p-full": "#d62b2b", "p-unsure": "#6b7280" };

// why: the answer to "where is there room?" without clicking anything: every lot, emptiest first.
