// why: the driver must hear when a claim ends without them, or they drive to a spot that is no longer theirs.
// boundary: reads last_release from SK-VIEW; shows a message and ends the route; changes no claim.
// ugly: a quiet release (the car came and later left, or the driver switched/cancelled) shows nothing.
function noticeRelease(news) {
    if (!news || news.id <= lastReleaseSeen) {
        return;
    }
    lastReleaseSeen = news.id;
    const words = RELEASE_WORDS[news.outcome];
    if (!words) {
        return;
