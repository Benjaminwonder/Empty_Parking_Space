function roundedPath(pts, r) {
    let d = "M" + pts[0][0] + " " + pts[0][1];
    for (let i = 1; i < pts.length - 1; i++) {
        const p0 = pts[i - 1];
        const p1 = pts[i];
        const p2 = pts[i + 1];
        const l1 = dist(p0, p1);
        const l2 = dist(p1, p2);
        const rr = Math.min(r, l1 / 2, l2 / 2);
        const ax = p1[0] + (p0[0] - p1[0]) / l1 * rr;
        const ay = p1[1] + (p0[1] - p1[1]) / l1 * rr;
        const bx2 = p1[0] + (p2[0] - p1[0]) / l2 * rr;
        const by2 = p1[1] + (p2[1] - p1[1]) / l2 * rr;
        d += " L" + ax + " " + ay + " Q" + p1[0] + " " + p1[1] + " " + bx2 + " " + by2;
    }
    const last = pts[pts.length - 1];
    d += " L" + last[0] + " " + last[1];
    return d;
}

function turnWord(h, t) {
    const cross = h[0] * t[1] - h[1] * t[0];
    return cross < 0 ? "left" : "right";
}

function unit(a, b) {
    const l = dist(a, b);
    return [(b[0] - a[0]) / l, (b[1] - a[1]) / l];
}

function meters(a, b) {
    return Math.round(dist(a, b) / PX_PER_M);
}

// Inside the lot only: entrance, down the lane, along the aisle, into the stall. This part is
// drawn to scale (PX_PER_M); the drive from the gate to the lot is not, until the map has
// real coordinates, so no distance is ever quoted for it.
function lotPath(st) {
    const sx = st.x + STALL_W / 2;
    const sy = st.y + STALL_H / 2;
    const pts = [
        [st.zone.laneX, LOT_ROAD_Y],
        [st.zone.laneX, st.aisleY],
        [sx, st.aisleY],
        [sx, sy]
    ];
    const clean = [pts[0]];
    for (let i = 1; i < pts.length; i++) {
        if (dist(clean[clean.length - 1], pts[i]) > 0.5) {
            clean.push(pts[i]);
        }
    }
    return clean;
}

// The drive on the campus picture: out of the Main Gate along E Michigan Ave to the lot pin's
// column, then straight to the pin. PLACEHOLDER geometry like the pins themselves; it shows the
// direction to go, not a road-accurate path.
function approachPath(z) {
    const m = markerFor(z);
    if (!m) {
        return null;
    }
    const endX = (m.x + m.w / 2) * S;
    const below = m.y * S > GATE_Y;
    const endY = below ? m.y * S : (m.y + m.h) * S;
    return [[GATE_X, GATE_Y], [endX, GATE_Y], [endX, endY]];
}

function totalMeters(pts) {
    let total = 0;
    for (let i = 1; i < pts.length; i++) {
        total += meters(pts[i - 1], pts[i]);
    }
    return total;
}

function stepsFor(st) {
    const aisle = st.zone.aisles[st.pair];
    const rowA = aisle.rowA.split(":").pop();
    const rowB = aisle.rowB ? aisle.rowB.split(":").pop() : null;
    const between = rowB ? "between rows " + rowA + " and " + rowB : "beside row " + rowA;
    const steps = ["Start at the Main Gate (N Woodland Blvd and E Michigan Ave)."];

    const ap = approachPath(st.zone);
    if (ap) {
        const along = unit(ap[0], ap[1]);
        const toLot = unit(ap[1], ap[2]);
        steps.push("Head " + (along[0] > 0 ? "east" : "west") + " on E Michigan Ave toward " +
                   lotName(st.zone) + ".");
        steps.push("Turn " + turnWord(along, toLot) + " toward the " + lotName(st.zone) + " entrance.");
    } else {
        steps.push("Drive to the " + lotName(st.zone) + " entrance.");
    }

    const pts = lotPath(st);
    const down = unit(pts[0], pts[1]);
    const alongAisle = unit(pts[1], pts[2]);
    const into = unit(pts[2], pts[3]);
    steps.push("Inside the lot, drive down the entrance lane " + meters(pts[0], pts[1]) + " m.");
    steps.push("Turn " + turnWord(down, alongAisle) + " onto the aisle " + between +
               " and follow it for " + meters(pts[1], pts[2]) + " m.");

    let note = "";
    if (st.type === "ADA") {
        note = " (ADA stall)";
    }
    if (st.type === "EV") {
        note = " (EV charging stall)";
    }
    steps.push("Spot " + st.id.split(":").pop() + " is on your " + turnWord(alongAisle, into) + note + ".");
    return steps;
}

